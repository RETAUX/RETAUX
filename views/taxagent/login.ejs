<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tax Agent Portal — RETAUX</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { min-height: 100vh; background: #060C14; font-family: 'Segoe UI', Arial, sans-serif; display: flex; align-items: center; justify-content: center; }
  .card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 40px 44px; width: 100%; max-width: 400px; }
  .logo { font-size: 2rem; font-weight: 900; letter-spacing: 0.04em; margin-bottom: 6px; }
  .logo span:first-child { color: #38BDF8; }
  .logo span:last-child  { color: #FFC107; }
  .subtitle { font-size: 0.8rem; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 28px; }
  label { display: block; font-size: 0.7rem; font-weight: 700; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 5px; }
  input[type=email], input[type=password] { width: 100%; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 11px 14px; font-size: 0.95rem; color: #fff; outline: none; margin-bottom: 16px; }
  input:focus { border-color: #38BDF8; }
  .btn { width: 100%; padding: 13px; background: #FFC107; color: #060C14; font-weight: 700; font-size: 1rem; border: none; border-radius: 8px; cursor: pointer; margin-top: 4px; }
  .btn:hover { background: #FFD54F; }
  .error { background: rgba(220,38,38,0.15); border: 1px solid rgba(220,38,38,0.3); color: #FCA5A5; border-radius: 6px; padding: 10px 14px; font-size: 0.87rem; margin-bottom: 16px; }
</style>
</head>
<body>
<div class="card">
  <div class="logo"><span>RE</span><span>TAUX</span></div>
  <div class="subtitle">Tax Agent Portal</div>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="POST" action="/taxagent/login">
    <label>Email</label>
    <input type="email" name="email" required autofocus placeholder="agent@example.com">
    <label>Password</label>
    <input type="password" name="password" required placeholder="••••••••">
    <button type="submit" class="btn">Sign in</button>
  </form>
</div>
</body>
</html>
