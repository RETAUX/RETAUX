<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Registrarse — RETAUX</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { min-height: 100vh; background: #060920; font-family: 'Source Sans 3','Segoe UI',Arial,sans-serif; overflow-x: hidden; color: #fff; }

    .bg { position: fixed; inset: 0; z-index: 0;
      background: radial-gradient(ellipse at 20% 50%, #0d1a7a 0%, transparent 60%),
                  radial-gradient(ellipse at 80% 20%, #0a4a7a 0%, transparent 55%),
                  #060920;
    }
    .bg-orb { position: absolute; border-radius: 50%; filter: blur(80px); animation: float 8s ease-in-out infinite; }
    .bg-orb-1 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(79,195,247,0.3) 0%, transparent 70%); top: -100px; left: -100px; }
    .bg-orb-2 { width: 400px; height: 400px; background: radial-gradient(circle, rgba(255,193,7,0.2) 0%, transparent 70%); bottom: -80px; right: -80px; animation-delay: -3s; }
    @keyframes float { 0%,100% { transform: translate(0,0); } 50% { transform: translate(20px,-20px); } }

    .page { position: relative; z-index: 1; min-height: 100vh; display: flex; flex-direction: column; }

    .top-nav { display: flex; align-items: center; justify-content: space-between; padding: 20px 40px; }
    .top-nav-logo { font-family: 'Fraunces',Georgia,serif; font-size: 1.3rem; font-weight: 700; color: #4FC3F7; text-decoration: none; letter-spacing: -0.02em; }
    .top-nav-logo em { color: #FFC107; font-style: normal; }

    #lang-selector { position: relative; }
    .lang-btn { background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25); color: #fff; font-family: 'Source Sans 3',sans-serif; font-size: 0.85rem; font-weight: 600; padding: 6px 12px; border-radius: 6px; cursor: pointer; white-space: nowrap; transition: background 0.15s; }
    .lang-btn:hover { background: rgba(255,255,255,0.2); }
    .lang-dropdown { display: none; position: absolute; right: 0; top: calc(100% + 6px); background: #0d1340; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; min-width: 110px; z-index: 200; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.5); }
    .lang-dropdown.open { display: block; }
    .lang-option { display: block; width: 100%; text-align: left; padding: 10px 16px; background: none; border: none; font-family: 'Source Sans 3',sans-serif; font-size: 0.88rem; color: rgba(255,255,255,0.75); cursor: pointer; transition: background 0.1s; }
    .lang-option:hover { background: rgba(255,255,255,0.08); color: #fff; }
    .lang-option--active { font-weight: 700; color: #4FC3F7; }

    .center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px 24px 60px; gap: 20px; }

    .hero-wordmark { text-align: center; line-height: 1; }
    .hero-wordmark .re  { font-family: 'Fraunces',Georgia,serif; font-size: clamp(40px,8vw,80px); font-weight: 700; color: #4FC3F7; letter-spacing: -0.03em; text-shadow: 0 0 60px rgba(79,195,247,0.6); display: inline-block; }
    .hero-wordmark .taux{ font-family: 'Fraunces',Georgia,serif; font-size: clamp(40px,8vw,80px); font-weight: 700; color: #FFC107; letter-spacing: -0.03em; text-shadow: 0 0 60px rgba(255,193,7,0.5);  display: inline-block; }

    .glass-card { background: rgba(255,255,255,0.06); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 36px 44px; width: 100%; max-width: 460px; box-shadow: 0 32px 64px rgba(0,0,0,0.4); }
    .card-title { font-family: 'Fraunces',Georgia,serif; font-size: 1.35rem; font-weight: 700; color: #fff; margin-bottom: 22px; }

    .form-group { margin-bottom: 16px; }
    .form-row { display: grid; grid-template-columns: repeat(2,1fr); gap: 14px; }
    @media (max-width: 480px) { .form-row { grid-template-columns: 1fr; } }

    .glass-card label { display: block; font-size: 0.72rem; font-weight: 600; color: rgba(255,255,255,0.55); margin-bottom: 5px; letter-spacing: 0.06em; text-transform: uppercase; }
    .glass-card input { width: 100%; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 11px 14px; font-size: 0.95rem; color: #fff; font-family: 'Source Sans 3',sans-serif; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
    .glass-card input[readonly] { opacity: 0.6; cursor: not-allowed; }
    .glass-card input::placeholder { color: rgba(255,255,255,0.25); }
    .glass-card input:focus { border-color: #4FC3F7; box-shadow: 0 0 0 3px rgba(79,195,247,0.15); }
    .mono-input { font-family: 'IBM Plex Mono','Courier New',monospace !important; letter-spacing: 0.1em; }

    .form-hint { font-size: 0.78rem; color: rgba(255,255,255,0.35); margin-top: 4px; }

    .password-wrapper { position: relative; }
    .password-wrapper input { padding-right: 46px; }
    .password-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: rgba(255,255,255,0.4); padding: 4px; line-height: 1; transition: color 0.15s; }
    .password-toggle:hover { color: rgba(255,255,255,0.8); }

    .btn-submit { width: 100%; padding: 14px; background: linear-gradient(135deg,#FFC107,#FFD54F); color: #060920; font-family: 'Source Sans 3',sans-serif; font-size: 1rem; font-weight: 700; border: none; border-radius: 10px; cursor: pointer; box-shadow: 0 4px 24px rgba(255,193,7,0.4); transition: transform 0.1s, box-shadow 0.2s; margin-top: 6px; }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(255,193,7,0.55); }

    .alert-dark { background: rgba(193,57,43,0.18); border: 1px solid rgba(193,57,43,0.35); color: #ff8a80; border-radius: 8px; padding: 10px 14px; font-size: 0.88rem; margin-bottom: 16px; }

    .auth-footer { text-align: center; margin-top: 18px; font-size: 0.88rem; color: rgba(255,255,255,0.4); }
    .auth-footer a { color: #4FC3F7; text-decoration: none; margin-left: 4px; }
    .auth-footer a:hover { text-decoration: underline; }

    .page-footer { text-align: center; padding: 16px; font-size: 11px; color: rgba(255,255,255,0.18); }
    .page-footer a { color: rgba(255,193,7,0.4); text-decoration: none; }

    @media (max-width: 480px) {
      .top-nav { padding: 14px 20px; }
      .glass-card { padding: 28px 20px; }
    }
  </style>
</head>
<body>
<div class="bg">
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>
</div>

<div class="page">
  <nav class="top-nav">
    <a href="/" class="top-nav-logo">RE<em>TAUX</em></a>
    <div id="lang-selector"></div>
  </nav>

  <div class="center">
    <div class="hero-wordmark">
      <span class="re">RE</span><span class="taux">TAUX</span>
    </div>

    <div class="glass-card">
      <p class="card-title" data-i18n="auth.register_title">Creá tu cuenta para empezar</p>

      <% if (error) { %><div class="alert-dark"><%= error %></div><% } %>

      <form method="POST" action="/register">
        <!-- honeypot: invisible para humanos, los bots lo completan -->
        <div style="position:absolute;left:-9999px;top:-9999px;opacity:0;pointer-events:none;" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label data-i18n="auth.firstName">NOMBRE</label>
            <input type="text" name="firstName" required placeholder="Juan">
          </div>
          <div class="form-group">
            <label data-i18n="auth.lastName">APELLIDO</label>
            <input type="text" name="lastName" required placeholder="García">
          </div>
        </div>
        <div class="form-group">
          <label data-i18n="auth.email">E-MAIL</label>
          <input type="email" name="email" required data-i18n-placeholder="auth.email_placeholder" placeholder="tu@email.com">
        </div>
        <div class="form-group">
          <label data-i18n="auth.password">CLAVE (8 DÍGITOS NUMÉRICOS)</label>
          <div class="password-wrapper">
            <input type="password" name="password" id="reg-pwd" required pattern="\d{8}" maxlength="8" inputmode="numeric" placeholder="••••••••" class="mono-input">
            <button type="button" class="password-toggle" onclick="togglePwd('reg-pwd',this)" aria-label="Mostrar/ocultar clave">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <p class="form-hint" data-i18n="auth.password_hint">Solo números, exactamente 8 dígitos. Ej: 12345678</p>
        </div>
        <% if (refCode) { %>
        <div class="form-group">
          <label data-i18n="auth.refCode">CÓDIGO DE REFERIDO</label>
          <input type="text" name="refCode" value="<%= refCode %>" readonly class="mono-input">
        </div>
        <% } else { %>
        <div class="form-group">
          <label data-i18n="auth.refCode_optional">CÓDIGO DE REFERIDO (OPCIONAL)</label>
          <input type="text" name="refCode" placeholder="RTX-XXXXXX" class="mono-input">
        </div>
        <% } %>
        <button type="submit" class="btn-submit" data-i18n="auth.btn_register">Crear cuenta</button>
      </form>

      <div class="auth-footer">
        <span data-i18n="auth.have_account">¿Ya tenés cuenta?</span>
        <a href="/login" data-i18n="auth.go_login">Ingresá aquí</a>
      </div>
    </div>
  </div>

  <footer class="page-footer">
    RETAUX © <%= new Date().getFullYear() %> &nbsp;·&nbsp;
    <a href="mailto:hola@retaux.com">hola@retaux.com</a>
  </footer>
</div>

<script>
function togglePwd(id, btn) {
  var inp = document.getElementById(id);
  var show = inp.type === 'password';
  inp.type = show ? 'text' : 'password';
  btn.innerHTML = show
    ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
    : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
}
</script>
<script src="/js/i18n.js"></script>
</body>
</html>
