<% if (typeof user !== 'undefined' && user) { %>
<!-- Widget flotante de ayuda -->
<div id="help-widget" style="
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 999;
  font-family: var(--font-body, 'Source Sans 3', sans-serif);
">
  <!-- Panel expandido -->
  <div id="help-panel" style="
    display: none;
    background: #1C2B45;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    margin-bottom: 10px;
    width: 230px;
    overflow: hidden;
  ">
    <!-- Header del panel -->
    <div style="
      background: #142138;
      padding: 12px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      gap: 8px;
    ">
      <span style="font-family:'Fraunces',Georgia,serif;font-size:1rem;font-weight:700;color:#fff;letter-spacing:-0.01em;">
        RE<span style="color:#D98A3D;">TAUX</span>
      </span>
      <span style="font-size:0.72rem;color:rgba(255,255,255,0.4);margin-left:auto;"><%- __('help.subtitle') %></span>
    </div>

    <!-- Links -->
    <div style="padding: 8px 0;">

      <a href="https://wa.me/61481315878" target="_blank" rel="noopener"
        style="
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 11px 16px;
          text-decoration: none;
          transition: background 0.15s;
          cursor: pointer;
          background: rgba(37,211,102,0.08);
        "
        onmouseover="this.style.background='rgba(37,211,102,0.16)'"
        onmouseout="this.style.background='rgba(37,211,102,0.08)'">
        <span style="font-size:1.1rem;">💬</span>
        <div>
          <div style="font-size:0.88rem;font-weight:600;color:#25D366;"><%- __('help.reta') %></div>
          <div style="font-size:0.75rem;color:rgba(255,255,255,0.4);line-height:1.3;"><%- __('help.reta_sub') %></div>
        </div>
        <span style="color:rgba(255,255,255,0.25);margin-left:auto;font-size:0.8rem;">→</span>
      </a>

      <div style="height:1px;background:rgba(255,255,255,0.06);margin:0 16px;"></div>

      <a href="/#quienes-somos" onclick="document.getElementById('help-panel').style.display='none';"
        style="
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 11px 16px;
          text-decoration: none;
          transition: background 0.15s;
          cursor: pointer;
        "
        onmouseover="this.style.background='rgba(255,255,255,0.06)'"
        onmouseout="this.style.background='transparent'">
        <span style="font-size:1.1rem;">👥</span>
        <div>
          <div style="font-size:0.88rem;font-weight:600;color:#fff;"><%- __('help.about') %></div>
          <div style="font-size:0.75rem;color:rgba(255,255,255,0.4);line-height:1.3;"><%- __('help.about_sub') %></div>
        </div>
        <span style="color:rgba(255,255,255,0.25);margin-left:auto;font-size:0.8rem;">→</span>
      </a>

      <div style="height:1px;background:rgba(255,255,255,0.06);margin:0 16px;"></div>

      <a href="mailto:hola@retaux.com"
        style="
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 11px 16px;
          text-decoration: none;
          transition: background 0.15s;
          cursor: pointer;
        "
        onmouseover="this.style.background='rgba(255,255,255,0.06)'"
        onmouseout="this.style.background='transparent'">
        <span style="font-size:1.1rem;">✉️</span>
        <div>
          <div style="font-size:0.88rem;font-weight:600;color:#fff;"><%- __('help.contact') %></div>
          <div style="font-size:0.75rem;color:#D98A3D;font-family:'IBM Plex Mono',monospace;">hola@retaux.com</div>
        </div>
        <span style="color:rgba(255,255,255,0.25);margin-left:auto;font-size:0.8rem;">→</span>
      </a>

      <div style="height:1px;background:rgba(255,255,255,0.06);margin:0 16px;"></div>

      <a href="/support"
        style="
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 11px 16px;
          text-decoration: none;
          transition: background 0.15s;
          cursor: pointer;
        "
        onmouseover="this.style.background='rgba(255,255,255,0.06)'"
        onmouseout="this.style.background='transparent'">
        <span style="font-size:1.1rem;">🛟</span>
        <div>
          <div style="font-size:0.88rem;font-weight:600;color:#fff;"><%- __('help.support') %></div>
          <div style="font-size:0.75rem;color:rgba(255,255,255,0.4);line-height:1.3;"><%- __('help.support_sub') %></div>
        </div>
        <span style="color:rgba(255,255,255,0.25);margin-left:auto;font-size:0.8rem;">→</span>
      </a>

    </div>
  </div>

  <!-- Botón toggle -->
  <button id="help-toggle" onclick="toggleHelp()" style="
    display: flex;
    align-items: center;
    gap: 8px;
    background: #1C2B45;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50px;
    padding: 10px 18px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    transition: box-shadow 0.2s, transform 0.15s;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    font-family: inherit;
    white-space: nowrap;
  "
  onmouseover="this.style.boxShadow='0 6px 28px rgba(0,0,0,0.45)';this.style.transform='translateY(-1px)'"
  onmouseout="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.3)';this.style.transform='none'">
    <span id="help-icon">💬</span>
    <span><%- __('help.btn') %></span>
    <span id="help-chevron" style="font-size:0.7rem;color:rgba(255,255,255,0.45);transition:transform 0.2s;">▲</span>
  </button>
</div>

<script>
(function(){
  var open = false;
  window.toggleHelp = function() {
    open = !open;
    document.getElementById('help-panel').style.display = open ? 'block' : 'none';
    document.getElementById('help-chevron').style.transform = open ? 'rotate(180deg)' : 'none';
    document.getElementById('help-icon').textContent = open ? '✕' : '💬';
  };
  document.addEventListener('click', function(e){
    if (open && !document.getElementById('help-widget').contains(e.target)) {
      open = false;
      document.getElementById('help-panel').style.display = 'none';
      document.getElementById('help-chevron').style.transform = 'none';
      document.getElementById('help-icon').textContent = '💬';
    }
  });
})();
</script>
<% } %>

