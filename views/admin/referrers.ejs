<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
  <title>Crear referidor — Admin · RETAUX</title>
  <style>
    .admin-wrap { display:flex; min-height:100vh; }
    .sidebar { width:210px; background:var(--ink); flex-shrink:0; padding:0; position:sticky; top:0; height:100vh; overflow-y:auto; }
    .sidebar-logo { padding:24px 20px 20px; font-family:var(--font-display); font-size:1.2rem; color:var(--paper); border-bottom:1px solid rgba(255,255,255,.1); }
    .sidebar-logo span { color:var(--ochre); }
    .sidebar nav { padding:12px 0; }
    .sidebar nav a { display:block; padding:10px 20px; color:rgba(247,242,231,.65); font-size:0.9rem; text-decoration:none; transition:all .15s; }
    .sidebar nav a:hover, .sidebar nav a.active { color:var(--paper); background:rgba(255,255,255,.07); text-decoration:none; }
    .sidebar-divider { border:none; border-top:1px solid rgba(255,255,255,.08); margin:8px 0; }
    .admin-main { flex:1; overflow-y:auto; padding:32px; background:var(--paper); }
    .ref-form-card {
      background:#fff;
      border:1px solid var(--line);
      border-radius:var(--radius);
      padding:36px 40px;
      max-width:480px;
    }
    .ref-field { margin-bottom:20px; }
    .ref-field label { display:block; font-size:0.82rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin-bottom:8px; }
    .ref-field input {
      width:100%;
      padding:13px 16px;
      border:1.5px solid var(--line);
      border-radius:var(--radius);
      font-size:1rem;
      background:var(--paper);
      color:var(--ink);
      font-family:var(--font-body);
      box-sizing:border-box;
      transition:border-color .15s;
    }
    .ref-field input:focus { outline:none; border-color:var(--ochre); }
    .ref-field input.mono { font-family:var(--font-mono); letter-spacing:.04em; }
    .code-preview-box {
      background:var(--paper-alt);
      border:1.5px dashed var(--ochre);
      border-radius:var(--radius);
      padding:12px 16px;
      margin-top:8px;
      font-family:var(--font-mono);
      font-size:1.4rem;
      font-weight:700;
      color:var(--ochre-dark);
      letter-spacing:.08em;
    }
    .btn-create {
      width:100%;
      padding:15px;
      background:var(--ink);
      color:var(--paper);
      border:none;
      border-radius:var(--radius);
      font-size:1rem;
      font-weight:700;
      cursor:pointer;
      transition:background .15s;
      font-family:var(--font-body);
      margin-top:8px;
    }
    .btn-create:hover { background:var(--ochre-dark); }
    .alert { padding:12px 16px; border-radius:var(--radius); margin-bottom:20px; font-size:0.9rem; }
    .alert-success { background:#EBF1ED; color:#1d5c2e; }
    .alert-error { background:#FBEAE5; color:#8b2e1c; }
    .ref-table { width:100%; border-collapse:collapse; font-size:0.9rem; margin-top:24px; }
    .ref-table th { text-align:left; padding:10px 12px; font-size:0.75rem; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); border-bottom:2px solid var(--line); }
    .ref-table td { padding:12px 12px; border-bottom:1px solid var(--line); }
    .code-badge { font-family:var(--font-mono); font-size:0.85rem; background:var(--paper-alt); padding:3px 10px; border-radius:4px; color:var(--ochre-dark); font-weight:700; }
  </style>
</head>
<body>
<div class="admin-wrap">
  <aside class="sidebar">
    <div class="sidebar-logo">RE<span>TAUX</span></div>
    <nav>
      <a href="/admin">Panel principal</a>
      <a href="/admin/referrals">Referidos</a>
      <a href="/admin/referrers" class="active">Crear referidor</a>
      <a href="/admin/calendar">Calendario de turnos</a>
      <hr class="sidebar-divider">
      <a href="/admin/logout" style="color:rgba(247,242,231,.35); font-size:0.82rem;">Cerrar sesión</a>
    </nav>
  </aside>

  <main class="admin-main">
    <h1 style="font-size:1.6rem;margin-bottom:6px">Crear usuario referidor</h1>
    <p style="color:var(--muted);margin-bottom:28px;font-size:0.9rem">Ingresá los datos del partner o influencer. Recibirá su código único para compartir.</p>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="ref-form-card">
      <form method="POST" action="/admin/referrers/create">

        <div class="ref-field">
          <label>Correo electrónico</label>
          <input type="email" name="email" required placeholder="ejemplo@correo.com" autocomplete="off">
        </div>

        <div class="ref-field">
          <label>Clave de acceso (8 dígitos)</label>
          <input type="text" name="pin" required placeholder="12345678" maxlength="8" class="mono" autocomplete="off">
        </div>

        <div class="ref-field">
          <label>Código de referido <span style="font-weight:400;color:var(--muted)">(lo elige el influencer)</span></label>
          <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
            <span style="font-family:var(--font-mono);font-size:1.1rem;font-weight:700;color:var(--muted);white-space:nowrap;">RTX-</span>
            <input type="text" name="codeSuffix" id="code-suffix" required placeholder="NOMBRE" maxlength="6" minlength="3" class="mono"
              style="text-transform:uppercase;flex:1;text-align:left;" oninput="this.value=this.value.replace(/[^A-Za-z0-9]/g,'').toUpperCase();updatePreview()" autocomplete="off">
          </div>
          <div style="font-size:0.78rem;color:var(--muted);margin-bottom:6px">Vista previa:</div>
          <div class="code-preview-box" id="code-preview">RTX-</div>
          <small style="color:var(--muted);font-size:0.78rem;">3 a 6 letras o números, sin espacios ni símbolos.</small>
        </div>

        <div class="ref-field" style="margin-bottom:0">
          <label>Nombre completo</label>
          <input type="text" name="fullName" required placeholder="Yo Me Animo">
        </div>

        <button type="submit" class="btn-create" style="margin-top:24px">Crear usuario referidor</button>
      </form>
    </div>

    <% if (referrers.length > 0) { %>
    <div style="margin-top:40px">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:14px;">
        <div>
          <h2 style="font-size:1.1rem;margin:0 0 2px 0">Referidores activos (<span id="ref-count"><%= referrers.length %></span> de <%= referrers.length %>)</h2>
          <p style="font-size:0.8rem;color:var(--muted);margin:0">Total general: <%= referrers.length %> referidores · AUD $<%= referrers.reduce((s,r)=>s+r.earned,0) %> ganado</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
          <input id="ref-search" type="text" placeholder="Buscar por nombre…"
            style="padding:7px 12px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);font-size:0.85rem;width:180px;"
            oninput="filterReferrers()">
          <select id="ref-month" onchange="filterReferrers()"
            style="padding:7px 12px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);font-size:0.85rem;cursor:pointer;">
            <option value="all">Todos los meses</option>
          </select>
          <select id="ref-status" onchange="filterReferrers()"
            style="padding:7px 12px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);font-size:0.85rem;cursor:pointer;">
            <option value="all">Todos</option>
            <option value="paid">Con pagados</option>
            <option value="pending">Sin pagados</option>
          </select>
        </div>
      </div>
      <p id="ref-empty" style="display:none;color:var(--muted);font-size:0.9rem;padding:20px 0;">No hay referidores que coincidan con el filtro.</p>
      <table class="ref-table" id="ref-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Código</th>
            <th style="text-align:center">Referidos</th>
            <th style="text-align:center">Pagados</th>
            <th style="text-align:right">Ganado</th>
          </tr>
        </thead>
        <tbody>
          <% referrers.forEach(function(r) { %>
          <tr data-name="<%= r.fullName.toLowerCase() %>" data-paid="<%= r.paidCount %>" data-month="<%= r.createdAt ? r.createdAt.substring(0,7) : '' %>">
            <td style="font-weight:600"><%= r.fullName %></td>
            <td style="color:var(--muted);font-size:0.85rem"><%= r.email %></td>
            <td><span class="code-badge"><%= r.referralCode %></span></td>
            <td style="text-align:center"><%= r.referredCount %></td>
            <td style="text-align:center;color:var(--eucalyptus);font-weight:600"><%= r.paidCount %></td>
            <td style="text-align:right;font-family:var(--font-mono);font-weight:700">AUD $<%= r.earned %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </main>
</div>

<script>
function updatePreview() {
  var suffix = (document.getElementById('code-suffix').value || '').toUpperCase();
  document.getElementById('code-preview').textContent = 'RTX-' + (suffix || '______');
}

// Poblar selector de meses con los meses que existen en la lista
(function() {
  var months = {};
  document.querySelectorAll('#ref-table tbody tr').forEach(function(row) {
    var m = row.dataset.month;
    if (m) months[m] = true;
  });
  var sel = document.getElementById('ref-month');
  Object.keys(months).sort().reverse().forEach(function(m) {
    var d = new Date(m + '-01');
    var label = d.toLocaleDateString('es-AR', { month: 'long', year: 'numeric' });
    var opt = document.createElement('option');
    opt.value = m;
    opt.textContent = label.charAt(0).toUpperCase() + label.slice(1);
    sel.appendChild(opt);
  });
})();

function filterReferrers() {
  var term   = (document.getElementById('ref-search').value || '').toLowerCase().trim();
  var status = document.getElementById('ref-status').value;
  var month  = document.getElementById('ref-month').value;
  var rows   = document.querySelectorAll('#ref-table tbody tr');
  var visible = 0;
  rows.forEach(function(row) {
    var name  = row.dataset.name || '';
    var paid  = parseInt(row.dataset.paid || '0', 10);
    var mon   = row.dataset.month || '';
    var matchName   = !term || name.includes(term);
    var matchStatus = status === 'all' || (status === 'paid' && paid > 0) || (status === 'pending' && paid === 0);
    var matchMonth  = month === 'all' || mon === month;
    var show = matchName && matchStatus && matchMonth;
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('ref-count').textContent = visible;
  document.getElementById('ref-empty').style.display = visible === 0 ? 'block' : 'none';
  document.getElementById('ref-table').style.display = visible === 0 ? 'none' : '';
}
</script>
</body>
</html>
