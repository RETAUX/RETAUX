<%- include('../layout/admin-header', { title: 'Panel admin' }) %>

<div class="admin-header">
  <div>
    <h2 style="font-family:'Fraunces',serif">Panel principal</h2>
    <p class="text-muted text-sm">Gestión de clientes RETAUX</p>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-card__label">Total clientes</div>
    <div class="stat-card__value"><%= totalUsers %></div>
  </div>
  <div class="stat-card">
    <div class="stat-card__label">Pagaron</div>
    <div class="stat-card__value"><%= totalPaid %></div>
  </div>
  <div class="stat-card">
    <div class="stat-card__label">Referidos</div>
    <div class="stat-card__value"><%= totalReferrals %></div>
  </div>
  <div class="stat-card">
    <div class="stat-card__label">Ingresos</div>
    <div class="stat-card__value mono" style="font-size:1.4rem">AUD <%= (totalPaid * 120).toLocaleString() %></div>
  </div>
</div>

<div class="card">
  <form method="GET" action="/admin" class="search-bar" style="margin-bottom:16px;flex-wrap:wrap;gap:8px">
    <input type="text" name="q" placeholder="Buscar por nombre o e-mail..." value="<%= q %>">
    <select name="status" style="padding:9px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:14px;outline:none">
      <option value="">Todos</option>
      <optgroup label="Formulario 1 — Individual Tax Return">
        <option value="taxreturn" <%= status === 'taxreturn' ? 'selected' : '' %>>Individual Tax Return</option>
        <option value="paid"      <%= status === 'paid'      ? 'selected' : '' %>>Tax Return — Pagaron</option>
        <option value="pending"   <%= status === 'pending'   ? 'selected' : '' %>>Tax Return — Sin pagar</option>
        <option value="unverified"<%= status === 'unverified'? 'selected' : '' %>>Tax Return — Sin verificar</option>
      </optgroup>
      <optgroup label="Formulario 2 — DASP">
        <option value="dasp" <%= status === 'dasp' ? 'selected' : '' %>>DASP — Superannuation</option>
      </optgroup>
      <option value="referrer" <%= status === 'referrer' ? 'selected' : '' %>>Referidores</option>
    </select>
    <button type="submit" class="btn btn--navy btn--sm">Buscar</button>
    <% if (q || status) { %><a href="/admin" class="btn btn--outline btn--sm">Limpiar</a><% } %>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Cliente</th>
          <th>E-mail</th>
          <th>Visa</th>
          <th>Estado</th>
          <th>Turno</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:32px">No hay clientes que coincidan.</td></tr>
        <% } %>
        <% users.forEach(u => { %>
        <tr>
          <td>
            <strong><%= u._type === 'dasp' ? (u._dasp && u._dasp.fullName ? u._dasp.fullName : u.fullName) : (u.firstName + ' ' + u.lastName) %></strong>
            <% if (u._type === 'dasp') { %>
              <br><span style="font-size:0.72rem;font-weight:700;color:#1D4ED8;background:#EFF6FF;padding:1px 6px;border-radius:4px;letter-spacing:0.04em;">DASP</span>
            <% } else { %>
              <br><span class="text-muted text-sm mono"><%= u.referralCode %></span>
            <% } %>
          </td>
          <td class="text-sm"><%= u.email %></td>
          <td class="text-sm">
            <% if (u._type === 'dasp') { %>
              <%= u._dasp && u._dasp.visaSubclass ? u._dasp.visaSubclass : (u.profile && u.profile.visaType ? u.profile.visaType.toUpperCase() : '—') %>
            <% } else { %>
              <%= u.profile && u.profile.visaType ? u.profile.visaType.toUpperCase() : '—' %>
            <% } %>
          </td>
          <td>
            <% if (u._type === 'dasp') { %>
              <% var ds = u.daspStatus || 'pending_review'; %>
              <span class="status-badge" style="background:<%= ds==='done'?'#DCFCE7':ds==='processing'?'#DBEAFE':'#FEF9C3' %>;color:<%= ds==='done'?'#166534':ds==='processing'?'#1D4ED8':'#854D0E' %>;border:none;">
                <%= ds==='done'?'✅ DASP listo':ds==='processing'?'⚙️ DASP en trámite':'⏳ DASP pendiente' %>
              </span>
            <% } else if (u.role === 'referrer') { %>
              <span class="status-badge" style="background:#E8F0FE;color:#1a56db;border:1px solid #93c5fd">Referidor</span>
            <% } else if (!u.verified) { %>
              <span class="status-badge status--cancelled">Sin verificar</span>
            <% } else if (!u.paymentComplete) { %>
              <span class="status-badge status--pending">Sin pagar</span>
            <% } else { %>
              <span class="status-badge status--paid">Pagó ✓</span>
            <% } %>
          </td>
          <td class="text-sm mono">—</td>
          <td>
            <% if (u._type === 'dasp') { %>
              <a href="/admin/user/<%= u.id %>/dasp-preview" class="btn btn--sm btn--outline" style="border-color:#3B82F6;color:#1D4ED8;">Ver DASP</a>
            <% } else { %>
              <a href="/admin/client/<%= u.id %>" class="btn btn--sm btn--outline">Ver</a>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layout/admin-footer') %>
