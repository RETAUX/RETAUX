<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
  <title>Chats WhatsApp — RETAUX Admin</title>
  <style>
    .chats-layout {
      display: flex;
      height: calc(100vh - 64px);
      overflow: hidden;
    }
    .chats-sidebar {
      width: 300px;
      min-width: 300px;
      border-right: 1px solid var(--border);
      overflow-y: auto;
      background: var(--bg);
    }
    .chats-sidebar h2 {
      font-size: 1rem;
      padding: 16px;
      margin: 0;
      border-bottom: 1px solid var(--border);
      font-family: var(--font-display);
    }
    .chat-item {
      display: block;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      transition: background 0.15s;
    }
    .chat-item:hover { background: rgba(255,255,255,0.04); }
    .chat-item.active { background: rgba(217,138,61,0.1); border-left: 3px solid var(--gold); }
    .chat-item-name { font-weight: 600; color: var(--text); font-size: 0.9rem; }
    .chat-item-phone { font-size: 0.75rem; color: var(--muted); margin-top: 2px; }
    .chat-item-preview { font-size: 0.78rem; color: var(--muted); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .chat-item-time { font-size: 0.7rem; color: var(--muted); float: right; }
    .chats-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .chats-header {
      padding: 14px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .chats-header strong { font-size: 1rem; }
    .chats-header span { font-size: 0.8rem; color: var(--muted); }
    .messages-area {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .msg-bubble {
      max-width: 70%;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 0.88rem;
      line-height: 1.5;
    }
    .msg-user {
      align-self: flex-start;
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border);
      color: var(--text);
      border-bottom-left-radius: 3px;
    }
    .msg-assistant {
      align-self: flex-end;
      background: #1C3A5E;
      color: #fff;
      border-bottom-right-radius: 3px;
    }
    .msg-admin {
      align-self: flex-end;
      background: #25523B;
      color: #fff;
      border-bottom-right-radius: 3px;
    }
    .msg-time { font-size: 0.68rem; color: rgba(255,255,255,0.4); margin-top: 4px; }
    .msg-time-user { font-size: 0.68rem; color: var(--muted); margin-top: 4px; }
    .msg-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 3px; opacity: 0.6; }
    .chats-input {
      padding: 14px 20px;
      border-top: 1px solid var(--border);
      display: flex;
      gap: 10px;
    }
    .chats-input input {
      flex: 1;
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.05);
      color: var(--text);
      font-size: 0.9rem;
      font-family: inherit;
    }
    .chats-input button {
      padding: 10px 20px;
      background: #25D366;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      font-size: 0.88rem;
    }
    .chats-input button:hover { background: #1ebe58; }
    .empty-state {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      gap: 8px;
    }
    .empty-state span { font-size: 2.5rem; }
    .wa-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #25D366;
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
    }
  </style>
</head>
<body>
  <%- include('../partials/nav', { active: 'chats', user: typeof user !== 'undefined' ? user : null }) %>

  <div class="chats-layout">
    <!-- Sidebar con lista de chats -->
    <div class="chats-sidebar">
      <h2>💬 Chats WhatsApp</h2>
      <% if (!convs || convs.length === 0) { %>
        <div style="padding:24px;color:var(--muted);font-size:0.85rem;text-align:center;">
          Ninguna conversación todavía.
        </div>
      <% } %>
      <% convs.forEach(function(c) { %>
        <%
          var lastMsg = c.messages && c.messages.length ? c.messages[c.messages.length - 1] : null;
          var preview = lastMsg ? lastMsg.content.slice(0, 50) : '—';
          var timeStr = c.updatedAt ? new Date(c.updatedAt).toLocaleString('es-AR', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' }) : '';
          var isActive = selected && selected.phone === c.phone;
        %>
        <a href="/admin/chats/<%= encodeURIComponent(c.phone) %>" class="chat-item <%= isActive ? 'active' : '' %>">
          <span class="chat-item-time"><%= timeStr %></span>
          <div class="chat-item-name"><%= c.name || 'Sin nombre' %></div>
          <div class="chat-item-phone">+<%= c.phone %></div>
          <div class="chat-item-preview"><%= preview %></div>
        </a>
      <% }); %>
    </div>

    <!-- Panel principal -->
    <div class="chats-main">
      <% if (!selected) { %>
        <div class="empty-state">
          <span>💬</span>
          <p>Seleccioná una conversación para verla</p>
        </div>
      <% } else { %>
        <!-- Header -->
        <div class="chats-header">
          <div>
            <strong><%= selected.name || 'Sin nombre' %></strong>
            <span class="wa-badge">WhatsApp</span><br>
            <span>+<%= selected.phone %></span>
            <% if (selected.userId) { %>
              &nbsp;·&nbsp;<a href="/admin/user/<%= selected.userId %>" style="font-size:0.78rem;color:var(--gold);">Ver perfil →</a>
            <% } %>
          </div>
        </div>

        <!-- Mensajes -->
        <div class="messages-area" id="messages-area">
          <% if (!messages || messages.length === 0) { %>
            <div style="text-align:center;color:var(--muted);font-size:0.85rem;margin:auto;">Sin mensajes aún.</div>
          <% } %>
          <% messages.forEach(function(m) { %>
            <%
              var isAdmin = m.content && m.content.startsWith('[Admin]');
              var isAssistant = m.role === 'assistant';
              var bubbleClass = isAdmin ? 'msg-admin' : (isAssistant ? 'msg-assistant' : 'msg-user');
              var label = isAdmin ? 'Vos (Admin)' : (isAssistant ? 'Reta' : 'Cliente');
              var content = isAdmin ? m.content.replace('[Admin] ', '') : m.content;
              var timeStr2 = m.ts ? new Date(m.ts).toLocaleString('es-AR', { hour:'2-digit', minute:'2-digit', day:'2-digit', month:'2-digit' }) : '';
            %>
            <div class="msg-bubble <%= bubbleClass %>">
              <div class="msg-label"><%= label %></div>
              <%= content %>
              <div class="<%= m.role === 'user' ? 'msg-time-user' : 'msg-time' %>"><%= timeStr2 %></div>
            </div>
          <% }); %>
        </div>

        <!-- Input para enviar -->
        <div class="chats-input">
          <form method="POST" action="/admin/chats/<%= encodeURIComponent(selected.phone) %>/send" style="display:flex;gap:10px;flex:1;">
            <input type="text" name="message" placeholder="Escribí un mensaje directo al cliente..." autocomplete="off" autofocus>
            <button type="submit">Enviar ↗</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    // Auto-scroll al último mensaje
    var area = document.getElementById('messages-area');
    if (area) area.scrollTop = area.scrollHeight;
  </script>
</body>
</html>
