<%- include('../layout/header', { title: __('dashboard.my_panel') || 'Mi panel', currentUser: user }) %>

<div class="container" style="padding:32px 24px 60px">
  <div class="page-header">
    <h1><%- __('dashboard.hello') %> <%= user.firstName %> 👋</h1>
    <p class="text-muted"><%- __('dashboard.fiscal_year') %> <%= user.profile ? (user.profile.fiscalYear || '2024') : '2024' %></p>
  </div>

  <% if (user.taxEstimate && user.taxReturnStage !== 'issued') { %>
  <% var est = user.taxEstimate; %>
  <% var fmtAUD = function(v) { return (v !== null && v !== undefined) ? '$' + Number(v).toFixed(2) : '—'; }; %>
  <div style="background:#fff;border:2px solid <%= est.status==='accepted'?'#A7F3D0':est.status==='doubts'?'#FDE68A':'#BFDBFE' %>;border-radius:12px;padding:24px 28px;margin-bottom:28px;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
      <div>
        <div style="font-size:0.75rem;font-weight:700;color:#6B7280;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Tu estimación de tax return</div>
        <div style="font-size:1.4rem;font-weight:800;color:#065F46;font-family:monospace;">Reintegro estimado: <%= fmtAUD(est.estimatedRefund) %> AUD</div>
      </div>
      <% if (est.status === 'accepted') { %>
        <span style="background:#D1FAE5;color:#065F46;font-size:0.82rem;font-weight:700;padding:6px 14px;border-radius:20px;">✅ Aceptaste esta estimación</span>
      <% } else if (est.status === 'doubts') { %>
        <span style="background:#FEF3C7;color:#92400E;font-size:0.82rem;font-weight:700;padding:6px 14px;border-radius:20px;">⚠ Enviaste tus dudas</span>
      <% } else { %>
        <span style="background:#DBEAFE;color:#1E40AF;font-size:0.82rem;font-weight:700;padding:6px 14px;border-radius:20px;">Esperando tu respuesta</span>
      <% } %>
    </div>

    <table style="width:100%;border-collapse:collapse;font-size:0.9rem;margin-bottom:20px;">
      <tr style="background:#F8FAFC;">
        <td style="padding:8px 12px;font-weight:600;color:#374151;border-bottom:1px solid #E5E7EB;width:60%;">Ingreso imponible (Taxable Income)</td>
        <td style="padding:8px 12px;border-bottom:1px solid #E5E7EB;font-family:monospace;text-align:right;"><%= fmtAUD(est.taxableIncome) %></td>
      </tr>
      <tr>
        <td style="padding:8px 12px;font-weight:600;color:#374151;border-bottom:1px solid #E5E7EB;">Impuesto a pagar (Tax Payable)</td>
        <td style="padding:8px 12px;border-bottom:1px solid #E5E7EB;font-family:monospace;text-align:right;"><%= fmtAUD(est.taxPayable) %></td>
      </tr>
      <% if (est.lowIncomeOffset) { %>
      <tr style="background:#F8FAFC;">
        <td style="padding:8px 12px;font-weight:600;color:#374151;border-bottom:1px solid #E5E7EB;">Low Income Tax Offset</td>
        <td style="padding:8px 12px;border-bottom:1px solid #E5E7EB;font-family:monospace;text-align:right;color:#065F46;">−<%= fmtAUD(est.lowIncomeOffset) %></td>
      </tr>
      <% } %>
      <% if (est.healthInsuranceOffset) { %>
      <tr>
        <td style="padding:8px 12px;font-weight:600;color:#374151;border-bottom:1px solid #E5E7EB;">Offset seguro de salud privado</td>
        <td style="padding:8px 12px;border-bottom:1px solid #E5E7EB;font-family:monospace;text-align:right;color:#065F46;">−<%= fmtAUD(est.healthInsuranceOffset) %></td>
      </tr>
      <% } %>
      <% if (est.otherOffsets) { %>
      <tr style="background:#F8FAFC;">
        <td style="padding:8px 12px;font-weight:600;color:#374151;border-bottom:1px solid #E5E7EB;">Otros offsets</td>
        <td style="padding:8px 12px;border-bottom:1px solid #E5E7EB;font-family:monospace;text-align:right;color:#065F46;">−<%= fmtAUD(est.otherOffsets) %></td>
      </tr>
      <% } %>
      <% if (est.totalOffsets) { %>
      <tr style="background:#FFF8E1;">
        <td style="padding:8px 12px;font-weight:700;color:#374151;border-bottom:1px solid #FDE68A;">Total offsets</td>
        <td style="padding:8px 12px;border-bottom:1px solid #FDE68A;font-family:monospace;text-align:right;font-weight:700;color:#065F46;">−<%= fmtAUD(est.totalOffsets) %></td>
      </tr>
      <% } %>
      <tr style="background:#F8FAFC;">
        <td style="padding:8px 12px;font-weight:600;color:#374151;border-bottom:1px solid #E5E7EB;">Tax retenido por el empleador</td>
        <td style="padding:8px 12px;border-bottom:1px solid #E5E7EB;font-family:monospace;text-align:right;color:#065F46;">−<%= fmtAUD(est.taxWithheld) %></td>
      </tr>
      <% if (est.otherCredits) { %>
      <tr>
        <td style="padding:8px 12px;font-weight:600;color:#374151;border-bottom:1px solid #E5E7EB;">Otros créditos</td>
        <td style="padding:8px 12px;border-bottom:1px solid #E5E7EB;font-family:monospace;text-align:right;color:#065F46;">−<%= fmtAUD(est.otherCredits) %></td>
      </tr>
      <% } %>
      <tr style="background:#ECFDF5;">
        <td style="padding:10px 12px;font-weight:800;color:#065F46;font-size:1rem;">Reintegro estimado</td>
        <td style="padding:10px 12px;font-family:monospace;text-align:right;font-weight:800;color:#065F46;font-size:1rem;"><%= fmtAUD(est.estimatedRefund) %></td>
      </tr>
    </table>

    <% if (est.status === 'pending') { %>
    <div style="border-top:1px solid #E5E7EB;padding-top:16px;">
      <p style="font-size:0.88rem;color:#374151;margin:0 0 16px;">Revisá tu estimación de reintegro. ¿Estás de acuerdo con los valores calculados por tu agente de impuestos?</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start;">
        <form method="POST" action="/dashboard/tax-estimate/accept" style="margin:0;">
          <button type="submit" style="background:#059669;color:#fff;border:none;border-radius:8px;padding:11px 24px;font-size:0.95rem;font-weight:700;cursor:pointer;" onclick="return confirm('¿Confirmás que aceptás esta estimación?')">
            ✅ Acepto la estimación
          </button>
        </form>
        <div>
          <button type="button" onclick="document.getElementById('doubt-form').style.display=document.getElementById('doubt-form').style.display==='none'?'block':'none'" style="background:#F59E0B;color:#fff;border:none;border-radius:8px;padding:11px 24px;font-size:0.95rem;font-weight:700;cursor:pointer;">
            ❓ Tengo dudas
          </button>
          <form id="doubt-form" method="POST" action="/dashboard/tax-estimate/doubt" style="display:none;margin-top:10px;">
            <textarea name="comment" rows="3" placeholder="Escribí tu consulta o comentario..." style="width:100%;box-sizing:border-box;border:1px solid #D1D5DB;border-radius:6px;padding:10px;font-size:0.88rem;resize:vertical;"></textarea>
            <button type="submit" style="margin-top:8px;background:#F59E0B;color:#fff;border:none;border-radius:6px;padding:8px 20px;font-size:0.88rem;font-weight:700;cursor:pointer;">Enviar consulta</button>
          </form>
        </div>
      </div>
    </div>
    <% } else if (est.status === 'doubts' && est.clientComment) { %>
    <div style="border-top:1px solid #E5E7EB;padding-top:12px;font-size:0.85rem;color:#78350F;background:#FFF8E1;border-radius:6px;padding:12px 16px;margin-top:4px;">
      Tu consulta: "<%= est.clientComment %>" — Un asesor te contactará pronto.
    </div>
    <% } %>
  </div>
  <% } %>

  <%- include('../partials/tax-calculator') %>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-card__label"><%- __('dashboard.appt_label') %></div>
      <div style="margin-top:8px">
        <% if (appointment) { %>
          <span class="status-badge status--<%= appointment.status %>">
            <%
              var apptLabel = appointment.status === 'pending' ? __('dashboard.status_pending')
                : appointment.status === 'confirmed' ? __('dashboard.status_confirmed')
                : appointment.status === 'completed' ? __('dashboard.status_completed')
                : __('dashboard.status_cancelled');
            %>
            <%= apptLabel %>
          </span>
        <% } else { %>
          <span class="status-badge status--no-code"><%- __('dashboard.status_no_appt') %></span>
        <% } %>
      </div>
      <% if (appointment) { %>
      <div class="stat-card__sub mono" style="margin-top:8px">
        <%= new Date(appointment.date).toLocaleDateString(lang === 'en' ? 'en-AU' : lang === 'fr' ? 'fr-FR' : lang === 'it' ? 'it-IT' : 'es-AR', { day:'numeric', month:'short', year:'numeric' }) %>
        — <%= appointment.hour %>:00 hs
      </div>
      <% } %>
    </div>

    <div class="stat-card">
      <div class="stat-card__label"><%- __('dashboard.ato_label') %></div>
      <div style="margin-top:8px">
        <span class="status-badge status--<%= user.atoLinkingStatus || 'no-code' %>">
          <%
            var atoLabel = user.atoLinkingStatus === 'no-code' ? __('dashboard.ato_no_code')
              : user.atoLinkingStatus === 'code-received' ? __('dashboard.ato_received')
              : __('dashboard.ato_linked');
          %>
          <%= atoLabel %>
        </span>
      </div>
      <% if (user.atoLinkingStatus === 'no-code') { %>
      <div class="stat-card__sub mt-1"><a href="/dashboard/linking"><%- __('dashboard.ato_send_code') %></a></div>
      <% } %>
    </div>

    <div class="stat-card">
      <div class="stat-card__label"><%- __('dashboard.refund_label') %></div>
      <% if (user.estimatedRefund !== null && user.estimatedRefund !== undefined) { %>
        <div class="stat-card__value" style="color:var(--green)">AUD <%= user.estimatedRefund.toLocaleString() %></div>
        <div class="stat-card__sub"><%- __('dashboard.refund_by_team') %></div>
      <% } else { %>
        <div style="margin-top:8px;color:var(--text-muted);font-size:14px"><%- __('dashboard.refund_pending') %></div>
      <% } %>
    </div>

    <div class="stat-card">
      <div class="stat-card__label"><%- __('dashboard.referrals_label') %></div>
      <div class="stat-card__value"><%= referrals.length %></div>
      <div class="stat-card__sub"><%= referrals.filter(r => r.status === 'paid').length %> <%- __('dashboard.referrals_paid_suffix') %> <%= referrals.filter(r=>r.status==='paid').length * 20 %></div>
    </div>
  </div>

  <div class="grid-2 mt-3" style="gap:20px">
    <div class="card">
      <h3 style="margin-bottom:12px"><%- __('dashboard.ref_code_title') %></h3>
      <div class="ref-box">
        <div class="ref-box__code"><%= user.referralCode %></div>
        <div class="ref-box__link"><%= refLink %></div>
      </div>
      <p class="text-muted text-sm mt-2"><%- __('dashboard.ref_share_text') %></p>
      <button onclick="var t=this;navigator.clipboard.writeText('<%= refLink %>');t.textContent='<%- __("dashboard.ref_copied") %>';setTimeout(function(){t.textContent='<%- __("dashboard.ref_copy_btn") %>'},2000)" class="btn btn--sm btn--outline mt-2"><%- __('dashboard.ref_copy_btn') %></button>
    </div>

    <div class="card">
      <h3 style="margin-bottom:12px"><%- __('dashboard.my_referrals') %></h3>
      <% if (referrals.length === 0) { %>
        <p class="text-muted text-sm"><%- __('dashboard.no_referrals') %></p>
      <% } else { %>
        <% referrals.forEach(r => { %>
          <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:14px">
            <span><%- __('dashboard.referred_label') %></span>
            <span class="status-badge status--<%= r.status === 'paid' ? 'paid' : r.status === 'ready' ? 'ready' : 'pending' %>">
              <%= r.status === 'paid' ? __('dashboard.status_paid') : r.status === 'ready' ? __('dashboard.status_ready') : __('dashboard.status_pending') %>
            </span>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div class="card mt-3">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <h3><%- __('dashboard.my_docs') %></h3>
      <a href="/onboarding/documents" class="btn btn--sm btn--outline"><%- __('dashboard.add_docs') %></a>
    </div>
    <% if (docs.length === 0) { %>
      <p class="text-muted text-sm"><%- __('dashboard.no_docs') %></p>
    <% } else { %>
      <div class="doc-list">
        <% docs.forEach(doc => { %>
          <div class="doc-item">📎 <%= doc.originalName %></div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="card mt-3">
    <h3 style="margin-bottom:8px"><%- __('dashboard.ato_section') %></h3>
    <p class="text-sm" style="margin-bottom:12px">
      <% if (user.atoLinkingStatus === 'no-code') { %>
        <%- __('dashboard.ato_no_code_text') %>
      <% } else if (user.atoLinkingStatus === 'code-received') { %>
        <%- __('dashboard.ato_received_text') %>
      <% } else { %>
        <%- __('dashboard.ato_linked_text') %>
      <% } %>
    </p>
    <% if (user.atoLinkingStatus !== 'linked') { %>
      <a href="/dashboard/linking" class="btn btn--sm btn--navy"><%- __('dashboard.ato_send_link') %></a>
    <% } %>
  </div>

  <div style="display:flex;gap:12px;margin-top:24px;flex-wrap:wrap">
    <a href="/dashboard/profile" class="btn btn--outline btn--sm"><%- __('dashboard.edit_profile') %></a>
    <a href="/dashboard/linking" class="btn btn--outline btn--sm"><%- __('dashboard.ato_code_link') %></a>
  </div>
</div>

<%- include('../layout/footer') %>
