<!DOCTYPE html>
<html lang="<%= lang || 'es' %>">
<head>
  <%- include('partials/head') %>
  <title>RETAUX — <%- __('meta.tagline') %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #060920; font-family: 'Source Sans 3','Segoe UI',Arial,sans-serif; color: #fff; overflow-x: hidden; }

    /* ── Animated background ── */
    .bg { position: fixed; inset: 0; z-index: 0;
      background: radial-gradient(ellipse at 15% 50%, #0d1a7a 0%, transparent 55%),
                  radial-gradient(ellipse at 85% 15%, #0a4a7a 0%, transparent 50%),
                  radial-gradient(ellipse at 55% 85%, #1a0a5c 0%, transparent 50%),
                  #060920;
    }
    .bg-orb { position: absolute; border-radius: 50%; filter: blur(90px); animation: float 9s ease-in-out infinite; }
    .bg-orb-1 { width: 600px; height: 600px; background: radial-gradient(circle, rgba(79,195,247,0.28) 0%, transparent 70%); top: -150px; left: -150px; }
    .bg-orb-2 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(255,193,7,0.2) 0%, transparent 70%); bottom: -100px; right: -100px; animation-delay: -4s; }
    .bg-orb-3 { width: 350px; height: 350px; background: radial-gradient(circle, rgba(124,58,237,0.18) 0%, transparent 70%); top: 35%; left: 55%; animation-delay: -6s; }
    .bg-orb-4 { width: 250px; height: 250px; background: radial-gradient(circle, rgba(79,195,247,0.12) 0%, transparent 70%); bottom: 20%; left: 10%; animation-delay: -2s; }
    @keyframes float {
      0%,100% { transform: translate(0,0) scale(1); }
      33% { transform: translate(40px,-40px) scale(1.06); }
      66% { transform: translate(-25px,25px) scale(0.96); }
    }

    .page { position: relative; z-index: 1; }

    /* ── Nav ── */
    .nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 20px 48px;
      position: sticky; top: 0; z-index: 50;
      background: rgba(6,9,32,0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .nav-logo { font-family: 'Fraunces',Georgia,serif; font-size: 1.25rem; font-weight: 700; color: #fff; text-decoration: none; letter-spacing: -0.01em; }
    .nav-logo em { color: #FFC107; font-style: normal; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { color: rgba(255,255,255,0.55); font-size: 0.9rem; text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: #fff; }
    /* Lang selector dark override para landing */
    #lang-selector { position: relative; }
    .lang-btn { background: rgba(255,255,255,0.12) !important; border: 1px solid rgba(255,255,255,0.25) !important; color: #fff !important; font-size: 0.85rem; }
    .lang-btn:hover { background: rgba(255,255,255,0.2) !important; }
    .lang-dropdown { background: #0d1340 !important; border: 1px solid rgba(255,255,255,0.15) !important; box-shadow: 0 8px 32px rgba(0,0,0,0.5) !important; }
    .lang-option { color: rgba(255,255,255,0.75) !important; }
    .lang-option:hover { background: rgba(255,255,255,0.08) !important; color: #fff !important; }
    .lang-option--active { color: #4FC3F7 !important; font-weight: 700; }

    .nav-cta { background: linear-gradient(135deg,#FFC107,#FFD54F); color: #060920 !important; font-weight: 700; padding: 9px 22px; border-radius: 8px; font-size: 0.9rem; transition: transform 0.1s, box-shadow 0.2s !important; box-shadow: 0 4px 16px rgba(255,193,7,0.3); }
    .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(255,193,7,0.45) !important; color: #060920 !important; }
    .nav-hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
    .nav-hamburger span { display: block; width: 22px; height: 2px; background: #fff; border-radius: 2px; }
    @media (max-width: 768px) {
      .nav { padding: 16px 24px; }
      .nav-hamburger { display: flex; }
      .nav-links { display: none; position: absolute; top: 100%; left: 0; right: 0; background: rgba(6,9,32,0.97); flex-direction: column; align-items: flex-start; padding: 12px 24px 20px; gap: 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
      .nav-links.open { display: flex; }
      .nav-links a { padding: 12px 0; width: 100%; border-bottom: 1px solid rgba(255,255,255,0.06); }
      .nav-cta { margin-top: 12px; border-bottom: none !important; }
    }

    /* ── Hero ── */
    .hero {
      min-height: 92vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 60px 24px 80px;
      text-align: center;
    }
    .hero-eyebrow {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(1rem, 2.5vw, 1.5rem);
      font-weight: 600;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.55);
      margin-bottom: 20px;
      animation: fade-up 0.8s ease both;
    }
    .hero-wordmark {
      line-height: 0.9;
      animation: fade-up 0.8s ease 0.1s both;
    }
    .hero-wordmark .re {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(88px, 20vw, 200px);
      font-weight: 700;
      color: #4FC3F7;
      letter-spacing: -0.04em;
      display: inline-block;
    }
    .hero-wordmark .taux {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(88px, 20vw, 200px);
      font-weight: 700;
      color: #FFC107;
      letter-spacing: -0.04em;
      display: inline-block;
    }
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .hero-tagline {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(1.4rem, 3vw, 2.2rem);
      font-weight: 600;
      color: rgba(255,255,255,0.9);
      margin-top: 24px;
      letter-spacing: -0.01em;
      animation: fade-up 0.8s ease 0.25s both;
    }
    .hero-tagline em { color: #FFC107; font-style: normal; }

    .hero-sub {
      font-size: 1rem;
      color: rgba(255,255,255,0.4);
      margin-top: 12px;
      max-width: 420px;
      line-height: 1.6;
      animation: fade-up 0.8s ease 0.35s both;
    }

    .hero-actions {
      display: flex; gap: 14px; flex-wrap: wrap;
      justify-content: center; margin-top: 36px;
      animation: fade-up 0.8s ease 0.45s both;
    }
    .btn-hero-primary {
      background: linear-gradient(135deg, #FFC107, #FFD54F);
      color: #060920; font-weight: 700; font-size: 1rem;
      padding: 14px 32px; border-radius: 10px;
      text-decoration: none; border: none; cursor: pointer;
      box-shadow: 0 4px 24px rgba(255,193,7,0.4);
      transition: transform 0.1s, box-shadow 0.2s;
      font-family: inherit;
    }
    .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(255,193,7,0.55); color: #060920; text-decoration: none; }
    .btn-hero-ghost {
      background: rgba(255,255,255,0.07);
      color: rgba(255,255,255,0.75);
      font-size: 1rem; padding: 14px 32px; border-radius: 10px;
      text-decoration: none;
      border: 1px solid rgba(255,255,255,0.15);
      transition: background 0.2s, color 0.2s;
      font-family: inherit;
    }
    .btn-hero-ghost:hover { background: rgba(255,255,255,0.12); color: #fff; text-decoration: none; }

    /* ── Scroll indicator ── */
    .scroll-hint {
      margin-top: 56px;
      color: rgba(255,255,255,0.2);
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      font-family: 'IBM Plex Mono', monospace;
      animation: fade-up 1s ease 0.7s both;
      display: flex; flex-direction: column; align-items: center; gap: 8px;
    }
    .scroll-hint::after {
      content: '';
      display: block;
      width: 1px; height: 40px;
      background: linear-gradient(to bottom, rgba(255,255,255,0.2), transparent);
      animation: scroll-line 2s ease-in-out infinite;
    }
    @keyframes scroll-line { 0%,100% { transform: scaleY(1); opacity: 0.5; } 50% { transform: scaleY(1.3); opacity: 1; } }

    /* ── How it works ── */
    .section-dark {
      padding: 100px 48px;
      position: relative;
    }
    .section-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: #4FC3F7;
      margin-bottom: 16px;
    }
    .section-title {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      color: #fff;
      margin-bottom: 12px;
      letter-spacing: -0.02em;
    }
    .section-title em { color: #FFC107; font-style: normal; }
    .section-sub { font-size: 1rem; color: rgba(255,255,255,0.4); max-width: 480px; line-height: 1.7; margin-bottom: 56px; }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 2px;
      max-width: 1000px;
      margin: 0 auto;
    }
    .step-card {
      padding: 36px 32px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      transition: background 0.2s, border-color 0.2s;
      position: relative;
    }
    .step-card:first-child { border-radius: 16px 0 0 16px; }
    .step-card:last-child { border-radius: 0 16px 16px 0; }
    .step-card:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); }
    .step-num {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      color: #FFC107;
      letter-spacing: 0.1em;
      margin-bottom: 16px;
      opacity: 0.7;
    }
    .step-card h3 { font-family: 'Fraunces', Georgia, serif; font-size: 1.2rem; color: #fff; margin-bottom: 10px; font-weight: 600; }
    .step-card p { font-size: 0.9rem; color: rgba(255,255,255,0.45); line-height: 1.65; margin: 0; }
    @media (max-width: 768px) {
      .steps-grid { grid-template-columns: 1fr; gap: 1px; }
      .step-card:first-child { border-radius: 16px 16px 0 0; }
      .step-card:last-child { border-radius: 0 0 16px 16px; }
      .section-dark { padding: 72px 24px; }
    }
    .founders-grid { display:grid; grid-template-columns:1fr 2fr; gap:48px; align-items:start; }
    .services-grid { display:grid; grid-template-columns:1fr 1fr; gap:24px; max-width:720px; margin:0 auto; }
    @media (max-width: 768px) {
      .founders-grid { grid-template-columns:1fr; gap:32px; }
      .founders-cards { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
      .services-grid { grid-template-columns:1fr; }
    }
    @media (max-width: 480px) {
      .founders-cards { grid-template-columns:1fr; }
    }

    /* ── Stats bar ── */
    .stats-bar {
      display: flex; align-items: center; justify-content: center;
      gap: 0; flex-wrap: wrap;
      border-top: 1px solid rgba(255,255,255,0.06);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding: 40px 48px;
    }
    .stat {
      flex: 1; min-width: 180px;
      text-align: center;
      padding: 20px;
      border-right: 1px solid rgba(255,255,255,0.06);
    }
    .stat:last-child { border-right: none; }
    .stat-val {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 2.5rem; font-weight: 700;
      color: #FFC107; line-height: 1;
      margin-bottom: 6px;
    }
    .stat-label { font-size: 0.82rem; color: rgba(255,255,255,0.35); letter-spacing: 0.05em; }
    @media (max-width: 640px) {
      .stats-bar { padding: 24px; gap: 0; }
      .stat { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.06); min-width: 140px; }
      .stat:last-child { border-bottom: none; }
    }

    /* ── CTA section ── */
    .cta-section {
      padding: 120px 48px;
      text-align: center;
    }
    .cta-section h2 {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 700; color: #fff; margin-bottom: 16px;
      letter-spacing: -0.02em; line-height: 1.1;
    }
    .cta-section h2 em { color: #4FC3F7; font-style: normal; }
    .cta-section p { color: rgba(255,255,255,0.4); font-size: 1rem; margin-bottom: 36px; }

    /* ── Footer ── */
    .footer {
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 28px 48px;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px;
    }
    .footer-brand { font-family: 'Fraunces',Georgia,serif; font-size: 1rem; font-weight: 700; color: rgba(255,255,255,0.4); }
    .footer-brand em { color: rgba(255,193,7,0.5); font-style: normal; }
    .footer p { font-size: 0.8rem; color: rgba(255,255,255,0.2); margin: 0; }
    .footer a { color: rgba(255,193,7,0.45); text-decoration: none; }
    .footer a:hover { color: #FFC107; }
    @media (max-width: 640px) { .footer { padding: 24px; flex-direction: column; text-align: center; } .cta-section { padding: 80px 24px; } }
  </style>
</head>
<body>
<div class="bg">
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>
  <div class="bg-orb bg-orb-3"></div>
  <div class="bg-orb bg-orb-4"></div>
</div>

<div class="page">

  <!-- Nav -->
  <nav class="nav">
    <a href="/" class="nav-logo">RE<em>TAUX</em></a>
    <div style="display:flex;flex-direction:column;gap:6px;margin-left:auto;margin-right:20px;flex-shrink:0;">
    <a href="https://www.tpb.gov.au/public-register?search=26346246" target="_blank" rel="noopener" title="Registered BAS Agent 26346246" style="display:flex;align-items:center;gap:7px;text-decoration:none;" aria-label="Registered BAS Agent 26346246">
      <svg width="38" height="38" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <path id="b-top" d="M 12,50 A 38,38 0 0 1 88,50"/>
          <path id="b-bot" d="M 20,50 A 30,30 0 0 0 80,50"/>
        </defs>
        <circle cx="50" cy="50" r="48" fill="#fff" stroke="#111" stroke-width="4"/>
        <circle cx="50" cy="50" r="34" fill="#8DC63F"/>
        <polyline points="31,52 44,65 69,38" fill="none" stroke="#fff" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round"/>
        <text font-family="Arial,sans-serif" font-size="8" font-weight="700" fill="#111" text-anchor="middle">
          <textPath href="#b-top" startOffset="50%">TAX PRACTITIONERS BOARD</textPath>
        </text>
        <text font-family="Arial,sans-serif" font-size="9" font-weight="700" fill="#111" text-anchor="middle">
          <textPath href="#b-bot" startOffset="50%">REGISTERED</textPath>
        </text>
      </svg>
      <div style="display:flex;flex-direction:column;line-height:1.25">
        <span style="font-size:0.58rem;font-weight:700;color:rgba(255,255,255,.45);letter-spacing:.05em;text-transform:uppercase">BAS agent</span>
        <span style="font-size:0.68rem;font-weight:700;color:#fff;font-family:'IBM Plex Mono',monospace">26346246</span>
      </div>
    </a>
    </div>
    <button class="nav-hamburger" id="nav-toggle" aria-label="Menú">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links" id="nav-links">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard"><%- __('nav.dashboard') %></a>
        <a href="/logout"><%- __('nav.logout') %></a>
      <% } else { %>
        <a href="/login"><%- __('nav.login') %></a>
        <a href="/register" class="nav-cta"><%- __('landing.nav_cta') %></a>
      <% } %>
      <div id="lang-selector"></div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-eyebrow" data-i18n="landing.hero_eyebrow">Australian Tax Return</div>

    <div class="hero-wordmark">
      <span class="re">RE</span><span class="taux">TAUX</span>
    </div>

    <div class="hero-actions">
      <a href="/register" class="btn-hero-primary" data-i18n="landing.cta_start">Empezar mi trámite</a>
    </div>
  </section>

  <!-- DASP Service Banner -->
  <div style="background:linear-gradient(135deg,#0A0E5C 0%,#1a1f7a 100%);padding:40px 48px;position:relative;overflow:hidden;">
    <div style="position:absolute;top:-60px;right:-60px;width:220px;height:220px;background:rgba(255,193,7,0.08);border-radius:50%;"></div>
    <div style="position:absolute;bottom:-40px;left:200px;width:140px;height:140px;background:rgba(79,195,247,0.06);border-radius:50%;"></div>
    <div style="max-width:1000px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px;position:relative;z-index:1;">
      <div>
        <div style="display:inline-block;background:#FFC107;color:#060920;font-family:'IBM Plex Mono',monospace;font-size:0.68rem;font-weight:700;letter-spacing:0.12em;padding:3px 10px;border-radius:4px;margin-bottom:10px;" data-i18n="landing.dasp_badge">NUEVO SERVICIO</div>
        <h2 style="font-family:'Fraunces',Georgia,serif;color:#fff;font-size:clamp(1.4rem,3vw,2rem);margin:0 0 8px;letter-spacing:-0.02em;" data-i18n="landing.dasp_title">DASP — Recuperá tu <em style="color:#FFC107;font-style:normal;">Superannuation</em></h2>
        <p style="color:rgba(255,255,255,0.55);font-size:0.95rem;margin:0;max-width:520px;line-height:1.6;" data-i18n="landing.dasp_desc">
          Si trabajaste en Australia, tu empleador depositó el 11% de tu sueldo en un fondo de jubilación.
          Al irte del país, podés recuperarlo. <strong style="color:rgba(255,255,255,0.8);">Te gestionamos el trámite ante el ATO.</strong>
        </p>
        <div style="display:flex;gap:16px;margin-top:14px;flex-wrap:wrap;">
          <span style="font-size:0.82rem;color:rgba(255,255,255,0.4);display:flex;align-items:center;gap:5px;" data-i18n="landing.dasp_time">⏱️ ~28 días de procesamiento</span>
          <span style="font-size:0.82rem;color:rgba(255,255,255,0.4);display:flex;align-items:center;gap:5px;" data-i18n="landing.dasp_abroad">✈️ Pago desde el exterior</span>
          <span style="font-size:0.82rem;color:rgba(255,255,255,0.4);display:flex;align-items:center;gap:5px;" data-i18n="landing.dasp_no_expire">📋 Sin plazo de vencimiento</span>
        </div>
      </div>
      <a href="/register" style="background:linear-gradient(135deg,#FFC107,#FFD54F);color:#060920;font-weight:700;font-size:0.97rem;padding:14px 28px;border-radius:10px;text-decoration:none;white-space:nowrap;box-shadow:0 4px 24px rgba(255,193,7,0.35);flex-shrink:0;" data-i18n="landing.dasp_cta">
        Solicitar DASP →
      </a>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-bar">
    <div class="stat">
      <div class="stat-val">AUD 150</div>
      <div class="stat-label" data-i18n="landing.stat1">por declaración</div>
    </div>
    <div class="stat">
      <div class="stat-val">AUD 20</div>
      <div class="stat-label" data-i18n="landing.stat2">por referido pagado</div>
    </div>
    <div class="stat">
      <div class="stat-val">30 días</div>
      <div class="stat-label" data-i18n="landing.stat3">devolución promedio</div>
    </div>
    <div class="stat">
      <div class="stat-val">100%</div>
      <div class="stat-label" data-i18n="landing.stat4">digital y seguro</div>
    </div>
  </div>

  <!-- Nuestros servicios -->
  <section class="section-dark" style="padding:80px 48px;text-align:center;border-top:1px solid rgba(255,255,255,0.06);">
    <div style="max-width:900px;margin:0 auto;">
      <div class="section-label" data-i18n="landing.services_label">Nuestros servicios</div>
      <h2 class="section-title" style="margin-bottom:12px;" data-i18n="landing.services_title">¿Qué trámite necesitás gestionar?</h2>
      <p class="section-sub" style="margin:0 auto 48px;" data-i18n="landing.services_sub">Seleccioná el servicio que corresponde a tu situación. Podés hacer ambos.</p>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:720px;margin:0 auto;">

        <!-- Tax Return -->
        <a href="/register" style="text-decoration:none;">
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:20px;padding:36px 28px;text-align:center;transition:all 0.2s;cursor:pointer;" onmouseover="this.style.background='rgba(79,195,247,0.1)';this.style.borderColor='#4FC3F7'" onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.borderColor='rgba(255,255,255,0.12)'">
            <div style="font-size:2.8rem;margin-bottom:16px;">🧾</div>
            <div style="font-family:'Fraunces',Georgia,serif;font-size:1.4rem;font-weight:700;color:#fff;margin-bottom:8px;">Tax Return</div>
            <div style="font-size:0.88rem;color:rgba(255,255,255,0.5);line-height:1.6;margin-bottom:20px;" data-i18n="landing.tax_desc">Declaración anual de impuestos. Recuperá lo que el ATO te debe por tu trabajo en Australia.</div>
            <div style="background:linear-gradient(135deg,#4FC3F7,#29b6f6);color:#060920;font-weight:700;font-size:0.9rem;padding:10px 20px;border-radius:8px;display:inline-block;" data-i18n="landing.tax_cta">Empezar trámite →</div>
          </div>
        </a>

        <!-- DASP -->
