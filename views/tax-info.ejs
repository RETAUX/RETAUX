<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
  <title>Calculadora de impuestos Australia — RETAUX</title>
  <style>
    /* ── Calculator ── */
    .calc-wrap {
      background: linear-gradient(160deg, #060920 0%, #0A0E5C 60%, #070A45 100%);
      border-radius: 20px;
      padding: 40px;
      margin-bottom: 32px;
      position: relative;
      overflow: hidden;
    }
    .calc-wrap::before {
      content:''; position:absolute; width:400px; height:400px; border-radius:50%;
      background: radial-gradient(circle, rgba(79,195,247,0.12) 0%, transparent 70%);
      top:-100px; right:-100px; pointer-events:none;
    }
    .calc-wrap h2 { color:#fff; font-size:1.6rem; margin:0 0 4px; }
    .calc-wrap .sub { color:rgba(255,255,255,0.45); font-size:0.9rem; margin-bottom:28px; }

    .calc-section-title {
      font-family: var(--font-mono); font-size:0.72rem; letter-spacing:0.2em;
      text-transform:uppercase; color:rgba(255,255,255,0.4); margin:20px 0 10px;
    }
    .calc-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    @media(max-width:640px){ .calc-grid { grid-template-columns:1fr; } }

    .calc-field label {
      display:block; font-size:0.75rem; font-weight:700;
      color:rgba(255,255,255,0.55); letter-spacing:0.05em;
      text-transform:uppercase; margin-bottom:5px;
    }
    .calc-field input, .calc-field select {
      width:100%; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.12);
      border-radius:8px; padding:11px 14px; font-size:0.95rem; color:#fff;
      font-family:inherit; outline:none; transition:border-color 0.2s, box-shadow 0.2s;
    }
    .calc-field input::placeholder { color:rgba(255,255,255,0.25); }
    .calc-field input:focus, .calc-field select:focus {
      border-color:#4FC3F7; box-shadow:0 0 0 3px rgba(79,195,247,0.15);
    }
    .calc-field select option { background:#060920; color:#fff; }
    .calc-field .hint { font-size:0.73rem; color:rgba(255,255,255,0.3); margin-top:4px; }

    .deduction-row {
      display:flex; align-items:center; gap:10px;
      padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.06);
    }
    .deduction-row label { margin:0; font-size:0.88rem; color:rgba(255,255,255,0.65); font-weight:400; flex:1; text-transform:none; letter-spacing:0; }
    .deduction-row input[type=number] {
      width:120px; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.1);
      border-radius:6px; padding:7px 10px; font-size:0.88rem; color:#fff; font-family:var(--font-mono);
      text-align:right; flex-shrink:0;
    }

    .calc-btn {
      width:100%; padding:14px; margin-top:20px;
      background:linear-gradient(135deg,#FFC107,#FFD54F);
      color:#060920; font-family:inherit; font-size:1rem; font-weight:700;
      border:none; border-radius:10px; cursor:pointer;
      box-shadow:0 4px 20px rgba(255,193,7,0.4); transition:transform 0.1s, box-shadow 0.2s;
    }
    .calc-btn:hover { transform:translateY(-1px); box-shadow:0 6px 28px rgba(255,193,7,0.55); }

    /* ── Results ── */
    .result-panel {
      display:none; margin-top:24px;
      background:rgba(255,255,255,0.04);
      border:1px solid rgba(255,255,255,0.1);
      border-radius:14px; padding:28px;
    }
    .result-panel.show { display:block; }

    .result-headline {
      text-align:center; margin-bottom:20px; padding-bottom:20px;
      border-bottom:1px solid rgba(255,255,255,0.08);
    }
    .result-headline .label { font-size:0.8rem; color:rgba(255,255,255,0.4); text-transform:uppercase; letter-spacing:0.1em; }
    .result-headline .amount {
      font-family:var(--font-mono); font-size:3rem; font-weight:700; line-height:1.1; margin:6px 0 4px;
    }
    .result-headline .amount.refund { color:#69f0ae; }
    .result-headline .amount.debt   { color:#ff8a80; }
    .result-headline .sublabel { font-size:0.85rem; color:rgba(255,255,255,0.4); }

    .result-bar { display:flex; height:12px; border-radius:6px; overflow:hidden; margin-bottom:20px; gap:2px; }
    .bar-seg { transition:width 0.5s cubic-bezier(.4,0,.2,1); border-radius:3px; }

    .breakdown { width:100%; border-collapse:collapse; font-size:0.9rem; }
    .breakdown tr td { padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.06); color:rgba(255,255,255,0.6); }
    .breakdown tr:last-child td { border-bottom:none; }
    .breakdown .val { text-align:right; font-family:var(--font-mono); font-weight:700; color:#fff; }
    .breakdown .val.neg  { color:#ff8a80; }
    .breakdown .val.gold { color:#FFC107; }
    .breakdown .val.green { color:#69f0ae; }
    .breakdown .total td { color:#fff; font-weight:700; border-top:1px solid rgba(255,255,255,0.2); padding-top:12px; }

    .rate-badge {
      display:inline-block; font-family:var(--font-mono); font-size:0.75rem;
      background:rgba(79,195,247,0.15); color:#4FC3F7; padding:3px 8px; border-radius:4px; margin-left:6px;
    }

    .disclaimer {
      background:rgba(255,193,7,0.08); border:1px solid rgba(255,193,7,0.2);
      border-radius:8px; padding:14px 18px; font-size:0.78rem;
      color:rgba(255,255,255,0.45); margin-top:20px; line-height:1.6;
    }
    .disclaimer strong { color:#FFC107; }

    .fy-pill {
      display:inline-block; font-family:var(--font-mono); font-size:0.75rem;
      background:rgba(255,193,7,0.15); color:#FFC107; padding:4px 12px;
      border-radius:20px; margin-bottom:20px;
    }

    /* ── Tax tables ── */
    .rate-table th, .rate-table td { font-size:0.9rem; }
    .rate-table td.rate { font-family:var(--font-mono); font-weight:700; color:var(--navy); }
    .nda-chip { font-family:var(--font-mono); font-size:0.8rem; background:var(--bg-page); border:1px solid var(--border); padding:6px 14px; border-radius:16px; }
    .nda-list { display:flex; flex-wrap:wrap; gap:8px; margin:10px 0 0; }

    @media (max-width: 640px) {
      .calc-wrap { padding: 20px 16px !important; }
      .result-headline .amount { font-size: 2rem; }
      .deduction-row input[type=number] { width: auto; max-width: 110px; min-width: 80px; }
      .table-wrap table { font-size: 0.82rem; }
    }
  </style>
</head>
<body>
  <%- include('partials/nav', { active: 'tax-info', user: user }) %>

  <section class="section">
    <div class="container" style="max-width:860px">

      <div class="section-eyebrow">Herramienta gratuita</div>
      <h1 style="font-size:1.9rem;margin-bottom:4px">Calculadora de impuestos Australia</h1>
      <p class="muted" style="margin-bottom:28px;max-width:580px">
        Calculá tu impuesto y devolución estimada para el año fiscal en Australia. Incluye Stage 3 Tax Cuts 2024-25, deducciones y offsets.
      </p>

      <!-- CALCULADORA -->
      <div class="calc-wrap">
        <span class="fy-pill">FY 2024–25 (1 Jul 2024 – 30 Jun 2025)</span>
        <h2>🧮 Calculadora de tax return</h2>
        <p class="sub">Completá los campos que conocés. Cuantos más detalles, más precisa la estimación.</p>

        <!-- Visa y situación -->
        <div class="calc-section-title">01 — Tu situación</div>
        <div class="calc-grid">
          <div class="calc-field">
            <label>Tipo de visa / residencia</label>
            <select id="calc-visa" onchange="onVisaChange()">
              <option value="whv">Working Holiday (417/462) — WHM</option>
              <option value="resident">Residente fiscal / Ciudadano</option>
              <option value="student">Student Visa (500) — como residente</option>
              <option value="nda">WHV + NDA (Chile, UK, Alemania...)</option>
            </select>
            <p class="hint" id="visa-hint">Tasa especial 15% sobre los primeros AUD 45.000</p>
          </div>
          <div class="calc-field">
            <label>¿Reclamaste el tax-free threshold?</label>
            <select id="calc-tfr" onchange="recalc()">
              <option value="no">No (WHM no aplica)</option>
              <option value="yes">Sí — soy residente y lo reclamé</option>
            </select>
            <p class="hint">Solo para residentes — exime los primeros AUD 18.200</p>
          </div>
        </div>

        <!-- Ingresos -->
        <div class="calc-section-title">02 — Ingresos del año fiscal</div>
        <div class="calc-grid">
          <div class="calc-field">
            <label>Ingresos con TFN — sueldos (AUD)</label>
            <input type="number" id="calc-tfn" placeholder="Ej: 42000" min="0" step="500" oninput="recalc()">
            <p class="hint">Total anual bruto de todos tus empleadores</p>
          </div>
          <div class="calc-field">
            <label>Tax withheld ya descontado (AUD)</label>
            <input type="number" id="calc-withheld" placeholder="Ver PAYG en tu group cert" min="0" step="100" oninput="recalc()">
            <p class="hint">Si no lo sabés, dejalo en 0 — te mostramos el impuesto a pagar</p>
          </div>
          <div class="calc-field">
            <label>Ingresos con ABN — trabajo propio (AUD)</label>
            <input type="number" id="calc-abn" placeholder="Ej: 8000" min="0" step="500" oninput="recalc()">
            <p class="hint">Ingresos totales facturados con tu ABN</p>
          </div>
          <div class="calc-field">
            <label>Gastos deducibles ABN (AUD)</label>
            <input type="number" id="calc-abn-exp" placeholder="Herramientas, kms, etc." min="0" step="100" oninput="recalc()">
            <p class="hint">Gastos directamente relacionados con tu trabajo ABN</p>
          </div>
        </div>

        <!-- Deducciones -->
        <div class="calc-section-title">03 — Deducciones laborales (TFN)</div>
        <p style="font-size:0.82rem;color:rgba(255,255,255,0.35);margin-bottom:12px">
          Ingresá los gastos relacionados con tu trabajo asalariado. Reducen tu ingreso imponible.
        </p>

        <div class="deduction-row">
          <label>🏠 Home office (hs/semana × semanas trabajadas × AUD 0,70/h)</label>
          <input type="number" id="ded-homeoffice" placeholder="0" min="0" oninput="updateHomeOffice()">
        </div>
        <div class="deduction-row" id="homeoffice-helper" style="display:none;padding:6px 0 10px;flex-wrap:wrap;gap:8px">
          <span style="font-size:0.78rem;color:rgba(255,255,255,0.35)">Hs/semana:</span>
          <input type="number" id="ho-hours" placeholder="5" min="0" max="80" style="width:70px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:5px 8px;color:#fff;font-size:0.82rem">
          <span style="font-size:0.78rem;color:rgba(255,255,255,0.35)">× semanas:</span>
          <input type="number" id="ho-weeks" placeholder="48" min="0" max="52" style="width:70px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:5px 8px;color:#fff;font-size:0.82rem">
          <button onclick="calcHomeOffice()" style="background:rgba(79,195,247,0.2);border:1px solid rgba(79,195,247,0.3);color:#4FC3F7;border-radius:6px;padding:5px 12px;font-size:0.78rem;cursor:pointer">Calcular</button>
          <span id="ho-result" style="font-size:0.78rem;color:#4FC3F7"></span>
        </div>
        <div class="deduction-row">
          <label>🚗 Gastos de auto (km de trabajo × AUD 0,88/km)</label>
          <input type="number" id="ded-car" placeholder="0" min="0" oninput="recalc()">
        </div>
        <div class="deduction-row">
          <label>📱 Teléfono e internet (% uso laboral del costo anual)</label>
          <input type="number" id="ded-phone" placeholder="0" min="0" oninput="recalc()">
        </div>
        <div class="deduction-row">
          <label>👔 Uniformes, ropa de trabajo, calzado</label>
          <input type="number" id="ded-uniform" placeholder="0" min="0" oninput="recalc()">
        </div>
        <div class="deduction-row">
          <label>🎓 Cursos, certificaciones, capacitaciones</label>
          <input type="number" id="ded-training" placeholder="0" min="0" oninput="recalc()">
        </div>
        <div class="deduction-row">
          <label>🔧 Herramientas y equipos de trabajo</label>
          <input type="number" id="ded-tools" placeholder="0" min="0" oninput="recalc()">
        </div>
        <div class="deduction-row">
          <label>🤝 Donaciones deducibles (tax-deductible receipt)</label>
          <input type="number" id="ded-donations" placeholder="0" min="0" oninput="recalc()">
        </div>
        <div class="deduction-row" style="border-bottom:none">
          <label>📝 Otros gastos laborales</label>
          <input type="number" id="ded-other" placeholder="0" min="0" oninput="recalc()">
        </div>

        <button class="calc-btn" onclick="recalc(true)">Ver mi estimación →</button>

        <!-- RESULTADO -->
        <div class="result-panel" id="result-panel">

          <div class="result-headline">
            <div class="label" id="res-headline-label">Estimación de devolución</div>
            <div class="amount" id="res-headline-amount">AUD 0</div>
            <div class="sublabel" id="res-headline-sub"></div>
          </div>

          <!-- Barra visual -->
          <div style="font-size:0.72rem;color:rgba(255,255,255,0.3);display:flex;justify-content:space-between;margin-bottom:4px">
            <span id="bar-label-1"></span><span id="bar-label-2"></span>
          </div>
          <div class="result-bar" id="result-bar"></div>

          <!-- Desglose -->
          <table class="breakdown">
            <tr><td>Ingreso bruto TFN</td><td class="val" id="rb-gross-tfn">—</td></tr>
            <tr><td>Ingreso bruto ABN</td><td class="val" id="rb-gross-abn">—</td></tr>
            <tr id="rb-deductions-row"><td>Total deducciones <span class="rate-badge" id="rb-ded-badge"></span></td><td class="val neg" id="rb-deductions">—</td></tr>
            <tr><td>Ingreso imponible</td><td class="val gold" id="rb-taxable">—</td></tr>
            <tr><td id="rb-tax-label">Impuesto bruto</td><td class="val neg" id="rb-tax">—</td></tr>
            <tr id="rb-lito-row"><td>Low Income Tax Offset (LITO)</td><td class="val green" id="rb-lito">—</td></tr>
            <tr id="rb-medicare-row"><td>Medicare Levy (2%)</td><td class="val neg" id="rb-medicare">—</td></tr>
            <tr class="total"><td>Impuesto neto total</td><td class="val neg" id="rb-net-tax">—</td></tr>
            <tr><td>Tasa efectiva</td><td class="val" id="rb-rate">—</td></tr>
            <tr><td>Ya retenido por empleador (PAYG)</td><td class="val green" id="rb-withheld">—</td></tr>
            <tr class="total">
              <td id="rb-result-label">Resultado estimado</td>
              <td class="val" id="rb-result">—</td>
            </tr>
          </table>

          <div class="disclaimer">
            <strong>⚠️ Estimación aproximada, no declaración oficial.</strong>
            Este cálculo se basa en las tasas del ATO para FY 2024-25 (Stage 3 Tax Cuts).
            El monto real depende de múltiples factores: deducciones adicionales, superannuation,
            otras fuentes de ingreso, offset SAPTO, año fiscal parcial, y revisión individual de cada caso.
            En RETAUX analizamos tu situación completa para maximizar tu devolución.
            <strong>No uses este número para tomar decisiones financieras.</strong>
          </div>

          <% if (!user) { %>
          <div style="text-align:center;margin-top:20px">
            <a href="/register" class="calc-btn" style="display:inline-block;max-width:300px;text-decoration:none">Empezar mi trámite con RETAUX →</a>
          </div>
          <% } %>
        </div>
      </div>

      <!-- TABLAS INFORMATIVAS -->
      <h2 style="font-size:1.4rem;margin-bottom:20px">Tasas FY 2024–25 (Stage 3 Tax Cuts)</h2>

      <div class="card">
        <h3>Working Holiday Makers (417/462)</h3>
        <p class="muted">Sin tramo exento. Sin Medicare Levy.</p>
        <table class="rate-table">
          <thead><tr><th>Tramo</th><th>Tasa</th></tr></thead>
          <tbody>
            <tr><td>AUD 0 – 45.000</td><td class="rate">15%</td></tr>
            <tr><td>AUD 45.001 – 135.000</td><td class="rate">30%</td></tr>
            <tr><td>AUD 135.001 – 190.000</td><td class="rate">37%</td></tr>
            <tr><td>Más de AUD 190.000</td><td class="rate">45%</td></tr>
          </tbody>
        </table>
      </div>

      <div class="card">
        <h3>Residentes fiscales / Student Visa / NDA</h3>
        <p class="muted">Incluye Stage 3 Tax Cuts desde julio 2024. + Medicare Levy 2%. Primer tramo exento AUD 18.200.</p>
        <table class="rate-table">
          <thead><tr><th>Tramo</th><th>Tasa</th></tr></thead>
          <tbody>
            <tr><td>AUD 0 – 18.200</td><td class="rate">0% (exento)</td></tr>
            <tr><td>AUD 18.201 – 45.000</td><td class="rate">16%</td></tr>
            <tr><td>AUD 45.001 – 135.000</td><td class="rate">30%</td></tr>
            <tr><td>AUD 135.001 – 190.000</td><td class="rate">37%</td></tr>
            <tr><td>Más de AUD 190.000</td><td class="rate">45%</td></tr>
          </tbody>
        </table>
        <p class="field-hint">LITO: hasta AUD 700 de descuento para ingresos bajo AUD 37.500 (se reduce progresivamente hasta AUD 66.667).</p>
      </div>

      <div class="card">
        <h3>Beneficio NDA</h3>
        <p class="muted">WHV de estos países pueden tributar como residentes si resulta más conveniente:</p>
        <div class="nda-list">
          <span class="nda-chip">🇨🇱 Chile</span>
          <span class="nda-chip">🇬🇧 Reino Unido</span>
          <span class="nda-chip">🇫🇮 Finlandia</span>
          <span class="nda-chip">🇹🇷 Turquía</span>
          <span class="nda-chip">🇳🇴 Noruega</span>
          <span class="nda-chip">🇩🇪 Alemania</span>
          <span class="nda-chip">🇮🇱 Israel</span>
          <span class="nda-chip">🇯🇵 Japón</span>
        </div>
      </div>

      <div class="alert alert-info">
        Tasas vigentes FY 2024-25 según ATO. Pueden cambiar cada año fiscal. Revisamos cada caso individualmente.
      </div>

      <% if (!user) { %>
      <div class="text-center" style="margin-top:28px">
        <a href="/register" class="btn btn--primary">Empezar mi trámite — AUD 150</a>
      </div>
      <% } %>

    </div>
  </section>

  <%- include('partials/footer') %>

<script>
// ── Helpers ──────────────────────────────────────────────────
function n(id){ return parseFloat(document.getElementById(id).value) || 0; }
function fmt(v){ return 'AUD ' + Math.round(v).toLocaleString('en-AU'); }
function pct(v){ return v.toFixed(1) + '%'; }
function setEl(id, val, cls){
  var el = document.getElementById(id);
  if(!el) return;
  el.textContent = val;
  if(cls){ el.className = 'val ' + cls; }
}

// ── Visa hint ────────────────────────────────────────────────
function onVisaChange(){
  var hints = {
    whv:      'Tasa especial 15% sobre primeros AUD 45.000. Sin Medicare.',
    resident: 'Tramo exento AUD 18.200. Tasas Stage 3. + Medicare 2%.',
    student:  'Mismas tasas que residente. Tramo exento AUD 18.200.',
    nda:      'WHV con acuerdo NDA — tributa como residente si conviene.'
  };
  var el = document.getElementById('visa-hint');
  var tfr = document.getElementById('calc-tfr');
  var visa = document.getElementById('calc-visa').value;
  if(el) el.textContent = hints[visa] || '';
  if(tfr){
    tfr.disabled = (visa === 'whv');
    if(visa === 'whv') tfr.value = 'no';
  }
  recalc();
}

// ── Home office helper ────────────────────────────────────────
function updateHomeOffice(){
  var el = document.getElementById('homeoffice-helper');
  if(el) el.style.display = 'flex';
  recalc();
}
function calcHomeOffice(){
  var hours = parseFloat(document.getElementById('ho-hours').value) || 0;
  var weeks = parseFloat(document.getElementById('ho-weeks').value) || 0;
  var total = Math.round(hours * weeks * 0.70);
  document.getElementById('ded-homeoffice').value = total;
  document.getElementById('ho-result').textContent = '= AUD ' + total;
  recalc();
}

// ── Main calculator ───────────────────────────────────────────
function calcTaxForVisa(taxableIncome, visa, tfr){
  var tax = 0;
  var isResident = (visa === 'resident' || visa === 'student' || visa === 'nda');

  if(visa === 'whv'){
    // WHM Schedule 15 FY 2024-25
    if(taxableIncome <= 45000)       tax = taxableIncome * 0.15;
    else if(taxableIncome <= 135000) tax = 6750 + (taxableIncome - 45000) * 0.30;
    else if(taxableIncome <= 190000) tax = 33750 + (taxableIncome - 135000) * 0.37;
    else                             tax = 54100 + (taxableIncome - 190000) * 0.45;
  } else {
    // Resident / Student / NDA — Stage 3 FY 2024-25
    var effectiveIncome = taxableIncome;
    if(tfr === 'yes'){
      if(effectiveIncome <= 18200)       tax = 0;
      else if(effectiveIncome <= 45000)  tax = (effectiveIncome - 18200) * 0.16;
      else if(effectiveIncome <= 135000) tax = 4288 + (effectiveIncome - 45000) * 0.30;
      else if(effectiveIncome <= 190000) tax = 31288 + (effectiveIncome - 135000) * 0.37;
      else                               tax = 51638 + (effectiveIncome - 190000) * 0.45;
    } else {
      // No tax-free threshold (e.g. part-year resident, NDA)
      if(effectiveIncome <= 45000)       tax = effectiveIncome * 0.16;
      else if(effectiveIncome <= 135000) tax = 7200 + (effectiveIncome - 45000) * 0.30;
      else if(effectiveIncome <= 190000) tax = 34200 + (effectiveIncome - 135000) * 0.37;
      else                               tax = 54550 + (effectiveIncome - 190000) * 0.45;
    }
  }
  return Math.max(0, tax);
}

function calcLITO(income){
  if(income <= 37500)  return 700;
  if(income <= 45000)  return 700 - (income - 37500) * 0.05;
  if(income <= 66667)  return 325 - (income - 45000) * 0.015;
  return 0;
}

function recalc(show){
  var visa      = document.getElementById('calc-visa').value;
  var tfr       = document.getElementById('calc-tfr').value;
  var tfnGross  = n('calc-tfn');
  var withheld  = n('calc-withheld');
  var abnGross  = n('calc-abn');
  var abnExp    = n('calc-abn-exp');
  var dedHome   = n('ded-homeoffice');
  var dedCar    = n('ded-car');
  var dedPhone  = n('ded-phone');
  var dedUniform= n('ded-uniform');
  var dedTrain  = n('ded-training');
  var dedTools  = n('ded-tools');
  var dedDon    = n('ded-donations');
  var dedOther  = n('ded-other');

  var totalDed = dedHome + dedCar + dedPhone + dedUniform + dedTrain + dedTools + dedDon + dedOther;
  var netABN   = Math.max(0, abnGross - abnExp);
  var grossTotal = tfnGross + abnGross;
  var taxableIncome = Math.max(0, tfnGross + netABN - totalDed);

  var isResident = (visa !== 'whv');

  var taxBruto = calcTaxForVisa(taxableIncome, visa, tfr);

  // LITO — only for residents
  var lito = isResident ? Math.max(0, calcLITO(taxableIncome)) : 0;

  // Medicare — only for residents
  var medicare = 0;
  if(isResident){
    if(taxableIncome > 34028) medicare = taxableIncome * 0.02;
    else if(taxableIncome > 24276) medicare = (taxableIncome - 24276) * 0.10;
  }

  var netTax    = Math.max(0, taxBruto - lito + medicare);
  var balance   = withheld - netTax;
  var effRate   = grossTotal > 0 ? (netTax / grossTotal * 100) : 0;

  // Update breakdown
  setEl('rb-gross-tfn', tfnGross > 0 ? fmt(tfnGross) : '—');
  setEl('rb-gross-abn', abnGross > 0 ? fmt(abnGross) + (abnExp > 0 ? ' (bruto)' : '') : '—');

  if(totalDed + abnExp > 0){
    document.getElementById('rb-deductions-row').style.display = '';
    var totalAllDed = totalDed + abnExp;
    setEl('rb-deductions', '− ' + fmt(totalAllDed), 'neg');
    document.getElementById('rb-ded-badge').textContent = Math.round(totalAllDed).toLocaleString('en-AU');
  } else {
    document.getElementById('rb-deductions-row').style.display = 'none';
  }

  setEl('rb-taxable', fmt(taxableIncome), 'gold');
  document.getElementById('rb-tax-label').textContent = 'Impuesto bruto' + (visa === 'whv' ? ' (WHM)' : ' (Stage 3)');
  setEl('rb-tax', '− ' + fmt(taxBruto), 'neg');

  if(isResident && lito > 0){
    document.getElementById('rb-lito-row').style.display = '';
    setEl('rb-lito', '+ ' + fmt(lito), 'green');
  } else {
    document.getElementById('rb-lito-row').style.display = 'none';
  }

  if(isResident && medicare > 0){
    document.getElementById('rb-medicare-row').style.display = '';
    setEl('rb-medicare', '+ ' + fmt(medicare), 'neg');
  } else {
    document.getElementById('rb-medicare-row').style.display = 'none';
  }

  setEl('rb-net-tax', fmt(netTax), 'neg');
  setEl('rb-rate', pct(effRate) + ' tasa efectiva');
  setEl('rb-withheld', withheld > 0 ? fmt(withheld) : 'No ingresado', 'green');

  // Headline
  var panel = document.getElementById('result-panel');
  var headAmt = document.getElementById('res-headline-amount');
  var headLabel = document.getElementById('res-headline-label');
  var headSub = document.getElementById('res-headline-sub');
  var rbResult = document.getElementById('rb-result');
  var rbResultLabel = document.getElementById('rb-result-label');

  if(withheld === 0){
    // Show tax owed only
    headLabel.textContent = 'Impuesto estimado a pagar';
    headAmt.textContent = fmt(netTax);
    headAmt.className = 'amount debt';
    headSub.textContent = 'Ingresá tu "Tax withheld" para ver si tenés devolución';
    setEl('rb-result', fmt(netTax), 'neg');
    rbResultLabel.textContent = 'Impuesto total estimado';
    renderBar([
      {w: Math.min(100, effRate), color:'#ff8a80', label:'Tax: ' + pct(effRate)},
      {w: Math.max(0, 100 - effRate), color:'rgba(255,255,255,0.1)', label:'Neto'}
    ]);
  } else if(balance >= 0){
    headLabel.textContent = '💚 Devolución estimada';
    headAmt.textContent = fmt(balance);
    headAmt.className = 'amount refund';
    headSub.textContent = 'Diferencia entre lo retenido y el impuesto real';
    setEl('rb-result', fmt(balance), 'green');
    rbResultLabel.textContent = 'Devolución estimada';
    renderBar([
      {w: Math.min(100, effRate), color:'#ff8a80', label:'Tax: ' + pct(effRate)},
      {w: Math.max(0, 100 - effRate - balance/grossTotal*100), color:'rgba(255,255,255,0.1)', label:''},
      {w: Math.min(100, balance/grossTotal*100), color:'#69f0ae', label:'Devolución'}
    ]);
  } else {
    headLabel.textContent = '⚠️ Diferencia a pagar (deuda estimada)';
    headAmt.textContent = fmt(Math.abs(balance));
    headAmt.className = 'amount debt';
    headSub.textContent = 'Se retuvo menos de lo que corresponde pagar';
    setEl('rb-result', '− ' + fmt(Math.abs(balance)), 'neg');
    rbResultLabel.textContent = 'Deuda estimada';
    renderBar([
      {w:100, color:'rgba(255,100,80,0.4)', label:'Withheld insuficiente'}
    ]);
  }

  if(show || panel.classList.contains('show')){
    panel.classList.add('show');
    if(show) panel.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }
}

function renderBar(segs){
  var bar = document.getElementById('result-bar');
  bar.innerHTML = segs.map(function(s){
    return '<div class="bar-seg" style="width:' + s.w + '%;background:' + s.color + ';flex-shrink:0"></div>';
  }).join('');
  var labels = segs.filter(function(s){ return s.label; });
  document.getElementById('bar-label-1').textContent = labels[0] ? labels[0].label : '';
  document.getElementById('bar-label-2').textContent = labels[labels.length-1] && labels.length > 1 ? labels[labels.length-1].label : '';
}

// Recalc on any input
document.querySelectorAll('.calc-field input, .calc-field select, .deduction-row input').forEach(function(el){
  el.addEventListener('input', function(){ recalc(false); });
});
</script>

</body>
</html>
