<!DOCTYPE html>
<html lang="<%= lang || 'es' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>¡Bienvenido/a a RETAUX!</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { min-height: 100vh; background: #060920; font-family: 'Source Sans 3','Segoe UI',Arial,sans-serif; overflow-x: hidden; color: #fff; }

    /* Background */
    .bg { position: fixed; inset: 0; z-index: 0;
      background: radial-gradient(ellipse at 20% 50%, #0d1a7a 0%, transparent 60%),
                  radial-gradient(ellipse at 80% 20%, #0a4a7a 0%, transparent 55%),
                  radial-gradient(ellipse at 60% 80%, #1a0a5c 0%, transparent 50%),
                  #060920;
    }
    .bg-orb { position: absolute; border-radius: 50%; filter: blur(80px); animation: float 8s ease-in-out infinite; }
    .bg-orb-1 { width: 600px; height: 600px; background: radial-gradient(circle, rgba(79,195,247,0.35) 0%, transparent 70%); top: -150px; left: -150px; }
    .bg-orb-2 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(255,193,7,0.25) 0%, transparent 70%); bottom: -100px; right: -100px; animation-delay: -3s; }
    .bg-orb-3 { width: 350px; height: 350px; background: radial-gradient(circle, rgba(45,106,79,0.25) 0%, transparent 70%); top: 30%; left: 55%; animation-delay: -6s; }
    @keyframes float { 0%,100% { transform: translate(0,0) scale(1); } 33% { transform: translate(30px,-30px) scale(1.05); } 66% { transform: translate(-20px,20px) scale(0.97); } }

    /* Confetti particles */
    .confetti-wrap { position: fixed; inset: 0; pointer-events: none; z-index: 2; overflow: hidden; }
    .confetti { position: absolute; width: 8px; height: 8px; opacity: 0; animation: confetti-fall linear forwards; }
    @keyframes confetti-fall {
      0%   { opacity: 1; transform: translateY(-20px) rotate(0deg); }
      100% { opacity: 0; transform: translateY(100vh) rotate(720deg); }
    }

    .page { position: relative; z-index: 3; min-height: 100vh; display: flex; flex-direction: column; }

    /* Nav */
    .top-nav { display: flex; align-items: center; justify-content: space-between; padding: 20px 40px; }
    .top-nav-logo { font-family: 'Fraunces',Georgia,serif; font-size: 1.3rem; font-weight: 700; color: #4FC3F7; text-decoration: none; letter-spacing: -0.02em; }
    .top-nav-logo em { color: #FFC107; font-style: normal; }

    /* Lang selector */
    #lang-selector { position: relative; }
    .lang-btn { background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25); color: #fff; font-family: 'Source Sans 3',sans-serif; font-size: 0.85rem; font-weight: 600; padding: 6px 12px; border-radius: 6px; cursor: pointer; white-space: nowrap; transition: background 0.15s; }
    .lang-btn:hover { background: rgba(255,255,255,0.2); }
    .lang-dropdown { display: none; position: absolute; right: 0; top: calc(100% + 6px); background: #0d1340; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; min-width: 110px; z-index: 200; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.5); }
    .lang-dropdown.open { display: block; }
    .lang-option { display: block; width: 100%; text-align: left; padding: 10px 16px; background: none; border: none; font-family: 'Source Sans 3',sans-serif; font-size: 0.88rem; color: rgba(255,255,255,0.75); cursor: pointer; transition: background 0.1s; }
    .lang-option:hover { background: rgba(255,255,255,0.08); color: #fff; }
    .lang-option--active { font-weight: 700; color: #4FC3F7; }

    /* Center */
    .center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px 24px 60px; gap: 28px; text-align: center; }

    /* Checkmark animation */
    .check-wrap { width: 80px; height: 80px; border-radius: 50%; background: rgba(45,106,79,0.25); border: 2px solid rgba(105,240,174,0.4); display: flex; align-items: center; justify-content: center; animation: pop-in 0.6s cubic-bezier(0.16,1,0.3,1) both; }
    @keyframes pop-in { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .check-icon { font-size: 2.5rem; line-height: 1; animation: pop-in 0.6s cubic-bezier(0.16,1,0.3,1) 0.1s both; }

    /* Wordmark */
    .hero-wordmark { line-height: 1; animation: hero-in 0.8s cubic-bezier(0.16,1,0.3,1) 0.2s both; }
    @keyframes hero-in { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: translateY(0); } }
    .hero-wordmark .re  { font-family: 'Fraunces',Georgia,serif; font-size: clamp(52px,11vw,100px); font-weight: 700; color: #4FC3F7; letter-spacing: -0.03em; text-shadow: 0 0 60px rgba(79,195,247,0.7), 0 0 120px rgba(79,195,247,0.3); display: inline-block; animation: glow-blue 4s ease-in-out infinite; }
    .hero-wordmark .taux{ font-family: 'Fraunces',Georgia,serif; font-size: clamp(52px,11vw,100px); font-weight: 700; color: #FFC107; letter-spacing: -0.03em; text-shadow: 0 0 60px rgba(255,193,7,0.6), 0 0 120px rgba(255,193,7,0.25); display: inline-block; animation: glow-gold 4s ease-in-out infinite; animation-delay: -2s; }
    @keyframes glow-blue { 0%,100% { text-shadow: 0 0 60px rgba(79,195,247,0.7); } 50% { text-shadow: 0 0 100px rgba(79,195,247,1), 0 0 180px rgba(79,195,247,0.5); } }
    @keyframes glow-gold { 0%,100% { text-shadow: 0 0 60px rgba(255,193,7,0.6); } 50% { text-shadow: 0 0 100px rgba(255,193,7,0.9), 0 0 180px rgba(255,193,7,0.4); } }

    /* Welcome text */
    .welcome-title { font-family: 'Fraunces',Georgia,serif; font-size: clamp(1.6rem,4vw,2.4rem); font-weight: 700; color: #fff; animation: hero-in 0.8s cubic-bezier(0.16,1,0.3,1) 0.3s both; }
    .welcome-subtitle { font-size: 1rem; color: rgba(255,255,255,0.55); max-width: 440px; line-height: 1.6; animation: hero-in 0.8s cubic-bezier(0.16,1,0.3,1) 0.4s both; }
    .welcome-subtitle strong { color: rgba(255,255,255,0.85); }

    /* Steps */
    .steps { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; animation: hero-in 0.8s cubic-bezier(0.16,1,0.3,1) 0.5s both; }
    .step { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 14px 18px; display: flex; align-items: center; gap: 10px; font-size: 0.88rem; color: rgba(255,255,255,0.7); }
    .step-num { font-family: 'IBM Plex Mono',monospace; font-size: 1rem; font-weight: 700; color: #FFC107; min-width: 24px; }

    /* CTA button */
    .btn-cta { display: inline-block; padding: 16px 40px; background: linear-gradient(135deg,#FFC107,#FFD54F); color: #060920; font-family: 'Source Sans 3',sans-serif; font-size: 1.05rem; font-weight: 700; border: none; border-radius: 12px; cursor: pointer; text-decoration: none; box-shadow: 0 4px 32px rgba(255,193,7,0.45); transition: transform 0.15s, box-shadow 0.2s; animation: hero-in 0.8s cubic-bezier(0.16,1,0.3,1) 0.6s both; }
    .btn-cta:hover { transform: translateY(-3px); box-shadow: 0 10px 40px rgba(255,193,7,0.6); color: #060920; text-decoration: none; }
    .btn-cta:active { transform: translateY(0); }

    /* Footer */
    .page-footer { text-align: center; padding: 16px; font-size: 11px; color: rgba(255,255,255,0.18); }
    .page-footer a { color: rgba(255,193,7,0.4); text-decoration: none; }

    @media (max-width: 480px) {
      .top-nav { padding: 14px 20px; }
      .steps { flex-direction: column; align-items: center; }
      .step { width: 100%; max-width: 320px; }
    }
  </style>
</head>
<body>
<div class="bg">
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>
  <div class="bg-orb bg-orb-3"></div>
</div>
<div class="confetti-wrap" id="confetti-wrap"></div>

<div class="page">
  <nav class="top-nav">
    <a href="/" class="top-nav-logo">RE<em>TAUX</em></a>
    <div id="lang-selector"></div>
  </nav>

  <div class="center">
    <div class="check-wrap">
      <span class="check-icon">✓</span>
    </div>

    <div class="hero-wordmark">
      <span class="re">RE</span><span class="taux">TAUX</span>
    </div>

    <h1 class="welcome-title">¡Hola, <%= firstName %>!</h1>

    <p class="welcome-subtitle">
      Tu cuenta está verificada. Ahora completá tus datos para que podamos gestionar tu <strong>tax return australiano</strong>.
    </p>

    <div class="steps">
      <div class="step">
        <span class="step-num">01</span>
        Datos personales y de visa
      </div>
      <div class="step">
        <span class="step-num">02</span>
        Subir payslips y documentos
      </div>
      <div class="step">
        <span class="step-num">03</span>
        Pago y turno asignado
      </div>
    </div>

    <a href="/onboarding/personal" class="btn-cta">
      Empezar mi trámite →
    </a>
  </div>

  <footer class="page-footer">
    RETAUX © <%= new Date().getFullYear() %> &nbsp;·&nbsp;
    <a href="mailto:hola@retaux.com">hola@retaux.com</a>
  </footer>
</div>

<script>
// Confetti
(function() {
  var colors = ['#FFC107','#4FC3F7','#69F0AE','#FF80AB','#CE93D8','#FFD54F'];
  var wrap = document.getElementById('confetti-wrap');
  for (var i = 0; i < 80; i++) {
    var el = document.createElement('div');
    el.className = 'confetti';
    var size = Math.random() * 8 + 4;
    el.style.cssText = [
      'left:' + Math.random() * 100 + '%',
      'top:' + (-size) + 'px',
      'width:' + size + 'px',
      'height:' + size + 'px',
      'background:' + colors[Math.floor(Math.random() * colors.length)],
      'border-radius:' + (Math.random() > 0.5 ? '50%' : '2px'),
      'animation-duration:' + (Math.random() * 2.5 + 2) + 's',
      'animation-delay:' + Math.random() * 1.5 + 's'
    ].join(';');
    wrap.appendChild(el);
  }
})();
</script>
<script src="/js/i18n.js"></script>
</body>
</html>
