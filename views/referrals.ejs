<!DOCTYPE html>
<html lang="<%= lang || 'es' %>">
<head>
  <%- include('partials/head') %>
  <title><%- __('referrals.page_title') %> — RETAUX</title>
  <style>
    .points-hero {
      background: linear-gradient(135deg, #0A0E5C 0%, #1a237e 100%);
      border-radius: 16px;
      padding: 36px 40px;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .points-hero h2 { color: #fff; margin: 0 0 6px; font-size: 1.1rem; font-weight: 600; opacity: 0.75; }
    .points-value { font-family: var(--font-mono); font-size: 3.5rem; font-weight: 700; color: #FFC107; line-height: 1; }
    .points-label { font-size: 0.85rem; color: rgba(255,255,255,0.5); margin-top: 4px; }
    .points-divider { width: 1px; height: 80px; background: rgba(255,255,255,0.15); }

    .ref-link-box {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 10px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    .ref-link-box .link-text {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: rgba(255,255,255,0.7);
      word-break: break-all;
      flex: 1;
    }
    .ref-link-box .code-tag {
      font-family: var(--font-mono);
      font-size: 1.3rem;
      font-weight: 700;
      color: #FFC107;
      letter-spacing: 0.05em;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .stat-box {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px;
      text-align: center;
    }
    .stat-box .val {
      font-family: var(--font-mono);
      font-size: 2rem;
      font-weight: 700;
      color: var(--navy);
      line-height: 1;
      margin-bottom: 6px;
    }
    .stat-box .val.gold { color: #FFC107; }
    .stat-box .val.green { color: var(--green); }
    .stat-box p { font-size: 0.82rem; color: var(--muted); margin: 0; }

    .how-it-works {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 2px;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 24px;
    }
    .hiw-step {
      padding: 24px 20px;
      background: var(--white);
      border-right: 1px solid var(--border);
      text-align: center;
    }
    .hiw-step:last-child { border-right: none; }
    .hiw-num {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: #FFC107;
      letter-spacing: 0.15em;
      margin-bottom: 10px;
    }
    .hiw-step h4 { font-size: 0.95rem; color: var(--text-navy); margin: 0 0 6px; }
    .hiw-step p { font-size: 0.82rem; color: var(--muted); margin: 0; line-height: 1.5; }

    .referral-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
      gap: 12px;
      flex-wrap: wrap;
    }
    .referral-row:last-child { border-bottom: none; }
    .referral-name { font-weight: 600; color: var(--text-navy); font-size: 0.95rem; }
    .referral-date { font-size: 0.8rem; color: var(--muted); margin-top: 2px; }
    .points-earned {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 1rem;
      color: var(--green);
    }
    .points-pending {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 1rem;
      color: #B8860B;
    }

    .copy-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
    .btn-copy-link {
      background: #FFC107;
      color: #0A0E5C;
      border: none;
      border-radius: 8px;
      padding: 10px 20px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      font-family: var(--font-body);
      transition: background 0.15s;
    }
    .btn-copy-link:hover { background: #FFD54F; }
    .share-btn {
      background: rgba(255,255,255,0.1);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      padding: 10px 20px;
      font-size: 0.9rem;
      cursor: pointer;
      font-family: var(--font-body);
      text-decoration: none;
      display: inline-block;
      transition: background 0.15s;
    }
    .share-btn:hover { background: rgba(255,255,255,0.18); color: #fff; text-decoration: none; }

    .payout-box {
      background: #E6F4EE;
      border: 1px solid #B8DECE;
      border-radius: 10px;
      padding: 20px 24px;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .payout-box .icon { font-size: 2rem; flex-shrink: 0; }
    .payout-box h4 { margin: 0 0 4px; color: var(--green); }
    .payout-box p { margin: 0; font-size: 0.88rem; color: var(--muted); }

    @media (max-width: 640px) {
      .points-hero { flex-direction: column; padding: 28px 24px; text-align: center; }
      .points-divider { display: none; }
      .points-value { font-size: 2.5rem; }
    }
  </style>
</head>
<body>
  <%- include('partials/nav', { active: 'referrals', user: user }) %>

  <section class="section">
    <div class="container" style="max-width:780px">

      <h1 style="font-size:1.8rem;margin-bottom:4px"><%- __('referrals.title') %></h1>
      <p class="muted" style="margin-bottom:28px"><%- __('referrals.subtitle') %></p>

      <!-- Hero de puntos -->
      <div class="points-hero">
        <div>
          <h2><%- __('referrals.aud_earned') %></h2>
          <div class="points-value">AUD <%= paidPoints %></div>
          <div class="points-label">
            <% if (pendingPoints > 0) { %>+ AUD <%= pendingPoints %> <%- __('referrals.pending_confirm') %><% } else { %><%- __('referrals.ready_payout') %><% } %>
          </div>
        </div>

        <div class="points-divider"></div>

        <div style="flex:1;min-width:0">
          <h2><%- __('referrals.your_code') %></h2>
          <div class="ref-link-box">
            <span class="code-tag"><%= user.referralCode %></span>
            <span class="link-text"><%= refLink %></span>
          </div>
          <div class="copy-row">
            <button class="btn-copy-link" onclick="copyLink()">📋 <%- __('referrals.copy_link') %></button>
            <a href="https://wa.me/?text=Usá%20mi%20código%20RETAUX%20y%20pagás%20AUD%20100%20en%20vez%20de%20AUD%20120%20por%20tu%20tax%20return%20en%20Australia%3A%20<%= encodeURIComponent(refLink) %>" target="_blank" class="share-btn">WhatsApp 📲</a>
          </div>

          <!-- Editor de código personalizado -->
          <div style="margin-top:18px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:10px;padding:16px 18px;">
            <p style="margin:0 0 10px;font-size:0.8rem;color:rgba(255,255,255,0.6);"><%- __('referrals.edit_code_label') %></p>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
              <span style="font-family:var(--font-mono);font-size:0.95rem;color:rgba(255,255,255,0.5);flex-shrink:0;">RTX-</span>
              <input id="custom-code-input" type="text" maxlength="10" placeholder="<%- __('referrals.edit_code_placeholder') %>"
                style="flex:1;min-width:120px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.25);border-radius:6px;padding:8px 12px;color:#fff;font-family:var(--font-mono);font-size:0.95rem;text-transform:uppercase;letter-spacing:0.05em;outline:none;"
                oninput="this.value=this.value.replace(/[^A-Za-z0-9]/g,'').toUpperCase()">
              <button onclick="saveCode()" style="background:#FFC107;color:#0A0E5C;border:none;border-radius:6px;padding:8px 16px;font-weight:700;font-size:0.88rem;cursor:pointer;"><%- __('referrals.edit_code_save') %></button>
            </div>
            <div id="code-status" style="margin-top:8px;font-size:0.8rem;min-height:18px;"></div>
            <p style="margin:10px 0 0;font-size:0.78rem;color:rgba(255,255,255,0.4);">⚠️ <%- __('referrals.edit_code_warning') %></p>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="stats-row">
        <div class="stat-box">
          <div class="val"><%= referrals.length %></div>
          <p><%- __('referrals.stat_total') %></p>
        </div>
        <div class="stat-box">
          <div class="val" style="color:#B8860B"><%= pendingCount %></div>
          <p><%- __('referrals.stat_pending') %></p>
        </div>
        <div class="stat-box">
          <div class="val green"><%= paidCount %></div>
          <p><%- __('referrals.stat_confirmed') %></p>
        </div>
        <div class="stat-box">
          <div class="val gold">AUD <%= paidPoints %></div>
          <p><%- __('referrals.stat_earned') %></p>
        </div>
      </div>

      <!-- Cómo funciona -->
      <h3 style="margin-bottom:12px"><%- __('referrals.how_title') %></h3>
      <div class="how-it-works" style="margin-bottom:24px">
        <div class="hiw-step">
          <div class="hiw-num">01</div>
          <h4><%- __('referrals.step1_title') %></h4>
          <p><%- __('referrals.step1_desc') %></p>
        </div>
        <div class="hiw-step">
          <div class="hiw-num">02</div>
          <h4><%- __('referrals.step2_title') %></h4>
          <p><%- __('referrals.step2_desc') %></p>
        </div>
        <div class="hiw-step">
          <div class="hiw-num">03</div>
          <h4><%- __('referrals.step3_title') %></h4>
          <p><%- __('referrals.step3_desc') %></p>
        </div>
        <div class="hiw-step">
          <div class="hiw-num">04</div>
          <h4><%- __('referrals.step4_title') %></h4>
          <p><%- __('referrals.step4_desc') %></p>
        </div>
      </div>

      <!-- Pago mensual info -->
      <div class="payout-box" style="margin-bottom:24px">
        <div class="icon">💸</div>
        <div>
          <h4><%- __('referrals.payout_title') %></h4>
          <p><%- __('referrals.payout_desc') %></p>
        </div>
      </div>

      <!-- Lista de referidos -->
      <div class="card">
        <h3 style="margin-bottom:16px"><%- __('referrals.list_title') %></h3>
        <% if (referrals.length === 0) { %>
          <div style="text-align:center;padding:32px 20px">
            <div style="font-size:3rem;margin-bottom:12px">🤝</div>
            <p class="muted" style="margin:0"><%- __('referrals.empty') %></p>
          </div>
        <% } else { %>
          <% referrals.forEach(function(r) { %>
            <div class="referral-row">
              <div>
                <div class="referral-name"><%= r.referredName.split(' ')[0] %> ···</div>
                <div class="referral-date"><%= new Date(r.createdAt).toLocaleDateString('es-AR', {day:'numeric',month:'short',year:'numeric'}) %></div>
              </div>
              <div style="text-align:right">
                <% if (r.status === 'paid') { %>
                  <div class="points-earned">+ AUD 20</div>
                  <div style="font-size:0.78rem;color:var(--green)"><%- __('referrals.status_confirmed') %></div>
                <% } else if (r.status === 'eligible') { %>
                  <div class="points-pending">+ AUD 20</div>
                  <div style="font-size:0.78rem;color:#B8860B"><%- __('referrals.status_verifying') %></div>
                <% } else { %>
                  <div style="font-family:var(--font-mono);font-weight:700;color:var(--muted)">+ AUD 20</div>
                  <div style="font-size:0.78rem;color:var(--muted)"><%- __('referrals.status_pending') %></div>
                <% } %>
              </div>
            </div>
          <% }); %>
          <div style="margin-top:16px;padding-top:16px;border-top:2px solid var(--border);display:flex;justify-content:space-between;align-items:center">
            <span style="font-weight:700"><%- __('referrals.total_confirmed') %></span>
            <span style="font-family:var(--font-mono);font-size:1.2rem;font-weight:700;color:var(--green)">AUD <%= paidPoints %></span>
          </div>
        <% } %>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>

<script>
function copyLink() {
  navigator.clipboard.writeText('<%= refLink %>').then(function(){
    var btn = document.querySelector('.btn-copy-link');
    btn.textContent = '✓ <%- __("referrals.copied") %>';
    btn.style.background = '#2D6A4F';
    btn.style.color = '#fff';
    setTimeout(function(){ btn.textContent = '📋 <%- __("referrals.copy_link") %>'; btn.style.background=''; btn.style.color=''; }, 2500);
  });
}

var CODE_STR = {
  short:     <%- JSON.stringify(__('referrals.code_err_short')) %>,
  chars:     <%- JSON.stringify(__('referrals.code_err_chars')) %>,
  reserved:  <%- JSON.stringify(__('referrals.code_err_reserved')) %>,
  taken:     <%- JSON.stringify(__('referrals.code_err_taken')) %>,
  saved:     <%- JSON.stringify(__('referrals.code_saved')) %>,
  saving:    <%- JSON.stringify(__('referrals.code_saving')) %>,
  error:     <%- JSON.stringify(__('referrals.code_err_generic')) %>
};

function setStatus(msg, color) {
  var el = document.getElementById('code-status');
  el.textContent = msg;
  el.style.color = color || 'rgba(255,255,255,0.5)';
}

function saveCode() {
  var inp = document.getElementById('custom-code-input');
  var suffix = inp.value.trim().toUpperCase().replace(/[^A-Z0-9]/g,'');

  if (suffix.length < 3) return setStatus(CODE_STR.short, '#FFC107');
  if (!/^[A-Z0-9]+$/.test(suffix)) return setStatus(CODE_STR.chars, '#FFC107');

  setStatus(CODE_STR.saving, 'rgba(255,255,255,0.5)');

  fetch('/referrals/update-code', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ suffix: suffix })
  })
  .then(function(r){ return r.json(); })
  .then(function(d){
    if (d.ok) {
      setStatus(CODE_STR.saved, '#4ade80');
      // Actualizar el código y link visibles
      document.querySelector('.code-tag').textContent = 'RTX-' + suffix;
      document.querySelector('.link-text').textContent = 'https://retaux.com/register?ref=RTX-' + suffix;
      inp.value = '';
    } else if (d.reason === 'taken') {
      setStatus(CODE_STR.taken, '#FCA5A5');
    } else if (d.reason === 'reserved') {
      setStatus(CODE_STR.reserved, '#FCA5A5');
    } else {
      setStatus(CODE_STR.error, '#FCA5A5');
    }
  })
  .catch(function(){ setStatus(CODE_STR.error, '#FCA5A5'); });
}
</script>

</body>
</html>
