<!DOCTYPE html>
<html lang="<%= lang || 'es' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%- __('auth.reset_title') %> — RETAUX</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { min-height: 100vh; background: #060920; font-family: 'Source Sans 3','Segoe UI',Arial,sans-serif; overflow-x: hidden; color: #fff; }
    .bg { position: fixed; inset: 0; z-index: 0;
      background: radial-gradient(ellipse at 20% 50%, #0d1a7a 0%, transparent 60%),
                  radial-gradient(ellipse at 80% 20%, #0a4a7a 0%, transparent 55%), #060920;
    }
    .bg-orb { position: absolute; border-radius: 50%; filter: blur(80px); animation: float 8s ease-in-out infinite; }
    .bg-orb-1 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(79,195,247,0.3) 0%, transparent 70%); top: -100px; left: -100px; }
    .bg-orb-2 { width: 400px; height: 400px; background: radial-gradient(circle, rgba(255,193,7,0.2) 0%, transparent 70%); bottom: -80px; right: -80px; animation-delay: -3s; }
    @keyframes float { 0%,100% { transform: translate(0,0); } 50% { transform: translate(20px,-20px); } }
    .page { position: relative; z-index: 1; min-height: 100vh; display: flex; flex-direction: column; }
    .top-nav { display: flex; align-items: center; justify-content: space-between; padding: 20px 40px; }
    .top-nav-logo { font-family: 'Fraunces',Georgia,serif; font-size: 1.3rem; font-weight: 700; color: #4FC3F7; text-decoration: none; letter-spacing: -0.02em; }
    .top-nav-logo em { color: #FFC107; font-style: normal; }
    .center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px 24px 60px; gap: 20px; }
    .hero-wordmark .re  { font-family: 'Fraunces',Georgia,serif; font-size: clamp(48px,10vw,90px); font-weight: 700; color: #4FC3F7; letter-spacing: -0.03em; display: inline-block; }
    .hero-wordmark .taux{ font-family: 'Fraunces',Georgia,serif; font-size: clamp(48px,10vw,90px); font-weight: 700; color: #FFC107; letter-spacing: -0.03em; display: inline-block; }
    .glass-card { background: rgba(255,255,255,0.06); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 36px 44px; width: 100%; max-width: 420px; box-shadow: 0 32px 64px rgba(0,0,0,0.4); }
    .card-title { font-family: 'Fraunces',Georgia,serif; font-size: 1.35rem; font-weight: 700; color: #fff; margin-bottom: 6px; }
    .card-sub { font-size: 0.88rem; color: rgba(255,255,255,0.45); margin-bottom: 24px; line-height: 1.5; }
    .card-sub strong { color: rgba(255,255,255,0.8); }
    .form-group { margin-bottom: 16px; }
    .glass-card label { display: block; font-size: 0.72rem; font-weight: 600; color: rgba(255,255,255,0.55); margin-bottom: 5px; letter-spacing: 0.06em; text-transform: uppercase; }
    .glass-card input { width: 100%; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 14px; font-size: 0.95rem; color: #fff; font-family: 'Source Sans 3',sans-serif; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
    .glass-card input.code-input { font-family: 'IBM Plex Mono',monospace; font-size: 2rem; letter-spacing: 0.4em; text-align: center; padding: 14px; }
    .glass-card input::placeholder { color: rgba(255,255,255,0.2); }
    .glass-card input:focus { border-color: #4FC3F7; box-shadow: 0 0 0 3px rgba(79,195,247,0.15); }
    .pwd-wrap { position: relative; }
    .pwd-wrap input { padding-right: 44px; }
    .pwd-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: rgba(255,255,255,0.4); padding: 4px; }
    .pwd-toggle:hover { color: rgba(255,255,255,0.8); }
    .btn-submit { width: 100%; padding: 14px; background: linear-gradient(135deg,#FFC107,#FFD54F); color: #060920; font-family: 'Source Sans 3',sans-serif; font-size: 1rem; font-weight: 700; border: none; border-radius: 10px; cursor: pointer; box-shadow: 0 4px 24px rgba(255,193,7,0.4); transition: transform 0.1s; margin-top: 6px; }
    .btn-submit:hover { transform: translateY(-2px); }
    .alert-dark { background: rgba(193,57,43,0.18); border: 1px solid rgba(193,57,43,0.35); color: #ff8a80; border-radius: 8px; padding: 10px 14px; font-size: 0.88rem; margin-bottom: 16px; }
    .back-link { text-align: center; margin-top: 18px; font-size: 0.88rem; color: rgba(255,255,255,0.4); }
    .back-link a { color: #4FC3F7; text-decoration: none; }
    .pwd-bar { height: 3px; border-radius: 2px; background: rgba(255,255,255,0.1); margin: 6px 0 2px; overflow: hidden; }
    .pwd-bar-fill { height: 100%; border-radius: 2px; transition: width 0.3s, background 0.3s; width: 0%; }
    .pwd-label { font-size: 0.72rem; color: rgba(255,255,255,0.35); }
    .page-footer { text-align: center; padding: 16px; font-size: 11px; color: rgba(255,255,255,0.18); }
    @media (max-width: 480px) { .top-nav { padding: 14px 20px; } .glass-card { padding: 28px 20px; } }
  </style>
</head>
<body>
<div class="bg"><div class="bg-orb bg-orb-1"></div><div class="bg-orb bg-orb-2"></div></div>
<div class="page">
  <nav class="top-nav">
    <a href="/" class="top-nav-logo">RE<em>TAUX</em></a>
    <div id="lang-selector"></div>
  </nav>
  <div class="center">
    <div class="hero-wordmark">
      <span class="re">RE</span><span class="taux">TAUX</span>
    </div>
    <div class="glass-card">
      <p class="card-title"><%- __('auth.reset_title') %></p>
      <p class="card-sub"><%- __('auth.reset_sub').replace('%s', '<strong>' + email + '</strong>') %></p>

      <% if (error) { %><div class="alert-dark"><%= error %></div><% } %>

      <form method="POST" action="/reset-password">
        <input type="hidden" name="email" value="<%= email %>">

        <div class="form-group">
          <label><%- __('auth.reset_code_label') %></label>
          <input type="text" name="code" class="code-input" required maxlength="6" minlength="6"
            inputmode="numeric" placeholder="······" autocomplete="one-time-code">
        </div>

        <div class="form-group">
          <label><%- __('auth.reset_new_pwd') %></label>
          <div class="pwd-wrap">
            <input type="password" name="newPin" id="new-pin" required placeholder="<%- __('auth.reset_new_placeholder') %>">
            <button type="button" class="pwd-toggle" onclick="toggleP('new-pin',this)" tabindex="-1" aria-label="<%- __('auth.show_hide_pwd') %>">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div class="pwd-bar"><div class="pwd-bar-fill" id="pwd-fill"></div></div>
          <div class="pwd-label" id="pwd-lbl"></div>
        </div>

        <div class="form-group">
          <label><%- __('auth.reset_repeat_pwd') %></label>
          <div class="pwd-wrap">
            <input type="password" name="newPinConfirm" id="new-pin2" required placeholder="<%- __('auth.reset_repeat_placeholder') %>">
            <button type="button" class="pwd-toggle" onclick="toggleP('new-pin2',this)" tabindex="-1" aria-label="<%- __('auth.show_hide_pwd') %>">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div id="match-fb" style="font-size:0.76rem;margin-top:4px;height:16px;"></div>
        </div>

        <button type="submit" class="btn-submit"><%- __('auth.reset_save_btn') %></button>
      </form>

      <div class="back-link"><a href="/forgot-password"><%- __('auth.reset_resend') %></a></div>
    </div>
  </div>
  <footer class="page-footer">RETAUX © <%= new Date().getFullYear() %></footer>
</div>
<script>
var PWD_STR = [
  '<%- __("auth.pwd_strength_0") %>',
  '<%- __("auth.pwd_strength_1") %>',
  '<%- __("auth.pwd_strength_2") %>',
  '<%- __("auth.pwd_strength_3") %>',
  '<%- __("auth.pwd_strength_4") %>',
  '<%- __("auth.pwd_strength_5") %>'
];
var PWD_MATCH_OK   = '<%- __("auth.pwd_match_ok") %>';
var PWD_MATCH_FAIL = '<%- __("auth.pwd_match_fail") %>';

function toggleP(id, btn) {
  var inp = document.getElementById(id);
  inp.type = inp.type === 'password' ? 'text' : 'password';
  btn.innerHTML = inp.type === 'text'
    ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
    : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
}
var pin = document.getElementById('new-pin');
var pin2 = document.getElementById('new-pin2');
var fill = document.getElementById('pwd-fill');
var lbl  = document.getElementById('pwd-lbl');
var mfb  = document.getElementById('match-fb');
pin.addEventListener('input', function(){
  var v = pin.value, s = 0;
  if(v.length>=4) s++; if(v.length>=8) s++; if(/[A-Z]/.test(v)&&/[a-z]/.test(v)) s++; if(/\d/.test(v)) s++; if(/[^a-zA-Z0-9]/.test(v)) s++;
  fill.style.width = ['0%','25%','50%','75%','100%'][s]; fill.style.background = ['#ff8a80','#FFB74D','#FFF176','#AED581','#69F0AE'][s];
  lbl.textContent = PWD_STR[s]; lbl.style.color = fill.style.background;
  if(pin2.value) checkMatch();
});
pin2.addEventListener('input', checkMatch);
function checkMatch(){
  if(!pin2.value){ mfb.textContent=''; return; }
  if(pin.value===pin2.value){ mfb.textContent=PWD_MATCH_OK; mfb.style.color='#69F0AE'; }
  else { mfb.textContent=PWD_MATCH_FAIL; mfb.style.color='#ff8a80'; }
}
</script>
<script src="/js/i18n.js"></script>
</body>
</html>
