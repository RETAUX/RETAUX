# ─────────────────────────────────────────────────────────────────────────────
# RETAUX — Variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=https://www.retaux.com

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Generá con: openssl rand -hex 64
JWT_SECRET=REEMPLAZAR_CON_VALOR_REAL

# Clave para crear el primer usuario admin (endpoint /create-admin)
# Generá con: openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c24
ADMIN_CREATION_KEY=REEMPLAZAR_CON_VALOR_REAL

# ── Stripe (pagos) ────────────────────────────────────────────────────────────
# ⚠️  IMPORTANTE: las claves actuales son sk_test_ (modo prueba).
#     Antes de ir a producción generá claves sk_live_ nuevas en dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR_CON_VALOR_REAL
STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZAR_CON_VALOR_REAL
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR_CON_VALOR_REAL

# ── Precios (AUD) ─────────────────────────────────────────────────────────────
SERVICE_PRICE_AUD=150
REFERRAL_CREDIT_AUD=20

# ── Brevo (emails transaccionales) ────────────────────────────────────────────
# Generá en: app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=REEMPLAZAR_CON_VALOR_REAL
MAIL_FROM=hola@retaux.com

# ── Link de pago ──────────────────────────────────────────────────────────────
SUPER_PAYMENT_LINK=REEMPLAZAR_CON_VALOR_REAL

# ── WhatsApp Business API (Meta) ──────────────────────────────────────────────
WA_VERIFY_TOKEN=REEMPLAZAR_CON_VALOR_REAL
WA_ACCESS_TOKEN=REEMPLAZAR_CON_VALOR_REAL
WA_PHONE_NUMBER_ID=REEMPLAZAR_CON_VALOR_REAL

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# Generá en: console.anthropic.com → API Keys
# Crear dos claves: RETAUX-produccion y RETAUX-desarrollo
ANTHROPIC_API_KEY=REEMPLAZAR_CON_VALOR_REAL
